Cell[BoxData[
 RowBox[{"DiscretePlot", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", " ", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Re", "[", 
      RowBox[{"Product", "[", 
       RowBox[{
        SqrtBox[
         RowBox[{
          RowBox[{"-", 
           FractionBox["1", "2"]}], "-", 
          FractionBox["\[ImaginaryI]", "2"]}]], ",", "  ", 
        RowBox[{"{", 
         StyleBox["n", "TI"], "}"}]}], "]"}], "]"}], ",", 
     "\[IndentingNewLine]", 
