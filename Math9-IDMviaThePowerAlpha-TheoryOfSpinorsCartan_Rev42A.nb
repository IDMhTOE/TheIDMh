Cell[CellGroupData[{

Cell["\<\

Spinor begets two matrex one matresx X and one e[0]^ e[0]e[1] e[1]^2 which \
begets another spinor\
\>", "Subsection",
 CellChangeTimes->{{3.574476541519875*^9, 3.57447669956675*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"e0", " ", "=", " ", "I"}], "\[IndentingNewLine]", 
 RowBox[{"e1", "=", " ", 
