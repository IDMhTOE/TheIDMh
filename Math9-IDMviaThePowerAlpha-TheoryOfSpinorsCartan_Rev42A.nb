Cell[BoxData[
 RowBox[{"iDMfundamentalFormScalerSquareLenthOfVectorXfromORIGINtoPoint\
\[CapitalPhi]", " ", "=", " ", 
  RowBox[{
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"theReflectionCountOfThisUniverse", "*", " ", 
      RowBox[{"Conjugate", "[", "I", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "theReflectionCountOfThisUniverse"}], "}"}]}], "]"}], 
   "//", "N"}]}]], "Input",
