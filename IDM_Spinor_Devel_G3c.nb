Cell[TextData[{
 "\nSingle inserted value thus single assumption: \[Zeta]0 = I a Complex \
Unity that is not NULL\n1st calculated value from single assumption in terms \
of I from x2 = -2I taking \[OpenCurlyQuote]-\[OpenCurlyQuote] to be the \
Conjugate of I --- ",
 StyleBox["fails as X^2  not = zero",
  FontColor->RGBColor[1., 0., 0.]]
}], "Text",
 CellChangeTimes->{{3.681523507435809*^9, 3.681523514723985*^9}}],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"\[Zeta]0", ",", "\[Zeta]1", ",", "x1", ",", "x2", ",", "x3"}], 
  "]"}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Zeta]0", " ", "=", 
  RowBox[{"Conjugate", "[", "I", "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"-", "\[ImaginaryI]"}]], "Output",
 CellChangeTimes->{3.667626494277995*^9, 3.667627265383759*^9, 
  3.671684052157354*^9, 3.680924440828376*^9, 3.681523364778263*^9}]
}, Open  ]],

