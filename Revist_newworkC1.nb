Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"intrinsicCurve3D", "[", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Kappa]_", ",", "\[Tau]_"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"s_", ",", "smin_", ",", "smax_"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"s0_", ",", "x0_", ",", "t0_", ",", "n0_"}], "}"}]}], "]"}], 
   " ", ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "t", ",", " ", "n", ",", " ", "b"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"x", "/.", " ", 
      RowBox[{"First", " ", "@", " ", "\[IndentingNewLine]", 
       RowBox[{"NDSolve", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"x", "'"}], "[", "s", "]"}], " ", "\[Equal]", " ", 
            RowBox[{"t", "[", "s", "]"}]}], ",", 
           "                               ", 
           RowBox[{
            RowBox[{"x", "[", "s0", "]"}], "\[Equal]", "x0"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"t", "'"}], "[", "s", "]"}], " ", "\[Equal]", " ", 
            RowBox[{"\[Kappa]", " ", 
             RowBox[{"n", "[", "s", "]"}]}]}], ",", 
           "                           ", 
           RowBox[{
            RowBox[{"t", "[", "s0", "]"}], "\[Equal]", "t0"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"n", "'"}], "[", "s", "]"}], " ", "\[Equal]", " ", 
            RowBox[{
             RowBox[{"\[Tau]", " ", 
              RowBox[{"b", "[", "s", "]"}]}], "-", " ", 
             RowBox[{"\[Kappa]", " ", 
              RowBox[{"t", "[", "s", "]"}]}]}]}], ",", "         ", 
           RowBox[{
            RowBox[{"n", "[", "s0", "]"}], "\[Equal]", "n0"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"b", "'"}], "[", "s", "]"}], " ", "\[Equal]", " ", 
            RowBox[{
             RowBox[{"-", "\[Tau]"}], " ", 
             RowBox[{"n", "[", "s", "]"}]}]}], ",", 
           "                          ", 
           RowBox[{
            RowBox[{"b", "[", "s0", "]"}], "\[Equal]", 
            RowBox[{"t0", "\[Cross]", "n0"}]}]}], "\[IndentingNewLine]", 
          "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "t", ",", " ", "n", ",", " ", "b"}], "}"}], 
         ",", " ", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"s", ",", " ", "smin", ",", " ", "smax"}], "}"}]}], 
        "\[IndentingNewLine]", "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[368]:=",
