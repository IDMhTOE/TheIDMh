  RowBox[{"1", ",", "1"}], "]"}]], "Input",
 FontSize->18],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"CellularAutomaton", "::", "initn"}], "MessageName"], 
  RowBox[{
  ":", " "}], "\<\"The initial condition specification \[NoBreak]\\!\\(1\\)\
\[NoBreak] should be of the form aspec, {aspec, bspec}, or {{{aspec1, off1}, \
{aspec2, off2},... {aspecn, offn}}, bspec} (n > 0). Each aspec must be a \
non-empty rank \[NoBreak]\\!\\(1\\)\[NoBreak] array whose elements at level \
\[NoBreak]\\!\\(1\\)\[NoBreak] are integers i in the range 0 <= i <= \
\[NoBreak]\\!\\(1\\)\[NoBreak]. \\!\\(\\*ButtonBox[\\\"\[RightSkeleton]\\\", \
ButtonStyle->\\\"Link\\\", ButtonFrame->None, \
ButtonData:>\\\"paclet:ref/CellularAutomaton\\\", ButtonNote -> \
\\\"CellularAutomaton::initn\\\"]\\)\"\>"}]], "Message", "MSG",
