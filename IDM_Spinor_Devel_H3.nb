Cell[TextData[{
 "\nSingle inserted value thus single assumption: \[Zeta]0 = I a Complex \
Unity that is not NULL\n1st calculated value from single assumption in terms \
of I from x2 = -2I taking \[OpenCurlyQuote]-\[OpenCurlyQuote] to be the \
Conjugate of I --- ",
 StyleBox["fails as X^2  not = zero",
  FontColor->RGBColor[1., 0., 0.]]
}], "Text",
