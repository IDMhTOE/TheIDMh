Cell[CellGroupData[{

Cell["Two\[Hyphen]variable 2D legend plot", "Subsection"],

Cell["\<\
coloredLegend[{xL_, x_, xMin_, xMax_, \[Delta]x_:1}] := 
Module[{maxOrder, xs, \[Lambda], equal},
xs = Table[x, {x, xMin, xMax, \[Delta]x}]; \[Lambda] = Length[xs]; 
Graphics[Table[{Hue[0.78 (kk - 1)/(\[Lambda] - 1)], Line[{{0, -12kk}, {0.5, \
-12kk}}],
                Text[StyleForm[TraditionalForm[
                   (HoldForm @@ {equal[xL, xs[[kk]]]}) /. equal -> Set]], \
{1.3, -12kk}]},
               {kk, 1, \[Lambda]}], Frame -> True, FrameTicks -> None, 
                  PlotRange -> {{0, 2},  {0, -12 \[Lambda] - 10}}]];\
\>", \
"Input",
  InitializationCell->True],

Cell["\<\
reImMultiPlot[F_, reimargabs_Symbol, {X_, Y__},  
                         {xL_, x_, xMin_, xMax_, \[Delta]x_}, 
                         {yL_, y_, yMin_, yMax_, \[Delta]y_}, 
              opts___] := 
Block[{cc = 1, theLegend},
Off[Plot::plnr]; Off[General::dbyz]; Off[Arg::indet];
theLegend = coloredLegend[{yL, y, yMin, yMax, \[Delta]y}];
Show[GraphicsArray[
 {sh = Show[Table[Chop[removeLineJumps[#, 3]]& @
 Plot[Evaluate[reimargabs @ F[X, Y]],  {x, xMin, xMax, \[Delta]x}, 
      Frame -> True, Axes -> True, 
      Evaluate[PlotStyle -> {{theLegend[[1]][[cc++, 1]]}}],
      FrameTicks -> {Automatic,
                     If[reimargabs === Arg, {-Pi, 0, Pi}, Automatic], None, \
None}, 
     FrameLabel -> {xL, \"f\"}, 
     DisplayFunction -> Identity, PlotPoints -> 600,
     AspectRatio -> 1/2, 
     PlotRange -> {All, If[reimargabs === Arg, 1.01 {-Pi, Pi},
                           Automatic]}], {y, yMin, yMax, \[Delta]y}], opts]; 
     On[Plot::plnr]; On[General::dbyz]; On[Arg::indet]; sh,
  Graphics[Rectangle[{0, 1/5}, {4/5, 4/5}, theLegend], 
           PlotRange -> {{0, 1}, {0, 1}}]}, GraphicsSpacing -> -0.1,
     PlotLabel -> StyleForm[TraditionalForm[(HoldForm @@
                            {reimargabs[F1[X, Y]]}) /. F1 -> F /. x -> xL /. \
y -> yL],
                            FontFamily -> \"Times\", FontSize -> 12]]]];
                            
reImMultiPlot[F_, reimargabs_List, rest___] := reImMultiPlot[F, #, rest]& /@ \
reimargabs\
\>", "Input",
  InitializationCell->True]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
Two\[Hyphen]variable 3D plots over the complex planes\
\>", \
"Subsection"],

Cell["\<\
Function[{new, old}, 
new[patchDatas_, ticks_, opts___, labelStrings_] := 
Show /@ Block[{$DisplayFunction = Identity},
      Show[old[#1, ticks, opts], 
       PlotLabel -> (TraditionalForm[#2])]& @@@ 
        Transpose[{patchDatas, 
                   ToExpression[#, InputForm, HoldForm]& /@ labelStrings}]]] \
@@@
{{realPartPicturePairList, realPartPicturePair},
 {absRealPartPicturePairList, absRealPartPicturePair}, 
 {imaginaryPartPicturePairList, imaginaryPartPicturePair},
 {absImaginaryPartPicturePairList, absImaginaryPartPicturePair},
 {absoluteValuePicturePairList, absoluteValuePicturePair},
 {argumentPicturePairList, argumentPicturePair},
 {argumentPicturePair2List, argumentPicturePair2},
 {zeroPolePictureList, zeroPolePicture}};\
\>", "Input",
  InitializationCell->True]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
Two\[Hyphen]variable 3D plots over cross\[Hyphen]variable \
planes\
\>", "Subsection"],

Cell[TextData[{
  "TwoArgumentFunctionReImPlot3D[F_, {reIm1_, reIm2_}, {var1_, var2_}, \
opts___] := \nModule[{X1 = Which[reIm1 === Re, NUx1Max NUx1, reIm1 === Im, \
NUy1Max NUy1,\n                   reIm1 === UC, Pi - 10^-10],\n        X2 = \
Which[reIm2 === Re, NUx2Max NUx2, reIm2 === Im, NUy2Max NUy2,\n               \
    reIm2 === UC, Pi - 10^-10],\n       Z, pR, ZR, \[Tau]1, \[Tau]2, als, f, \
g, \[CurlyEpsilon] = 10^-10, \n       p3DRe, p3DIm, p3DAbs, p3DArg, cpRe, \
cpIm, cpAbs, cpArg},\n                   \nZ = removePolygonSize /. {opts} /. \
removePolygonSize -> 1/2;    \n\npR[p3d_] := Last[FullOptions[p3d, \
PlotRange]];\n\nZR[p3d_] := Subtract @@ Reverse[pR[p3d]];\n\n{\[Tau]1,  \
\[Tau]2} = exponentDegrees /. {opts} /. exponentDegrees -> {1, 1};   \n\nals \
= {If[reIm1 === Re || reIm1 === Im, reIm1[var1]^\[Tau]1, \
Subscript[\[CurlyPhi], var1]],\n       If[reIm2 === Re || reIm2 === Im, \
reIm2[var2]^\[Tau]2, Subscript[\[CurlyPhi], var2]]};                \n\nf[x_, \
y_] = F[Which[reIm1 === Re, 1 x1^\[Tau]1, reIm1 === Im, I x1^\[Tau]1, \n      \
             ",
  StyleBox["(* unit circle case *)",
    FontWeight->"Plain"],
  " reIm1 === UC, Exp[I x1]], \n             Which[reIm2 === Re, 1 \
x2^\[Tau]2, reIm2 === Im, I x2^\[Tau]2, \n                   ",
  StyleBox["(* unit circle case *)",
    FontWeight->"Plain"],
  " reIm2 === UC, Exp[I x2]]];\n                   \ng[x_, y_] := g[x, y] = \
f[x, y];  \n",
  StyleBox["(* the 3D plots *)",
    FontWeight->"Plain"],
  "\n{p3DRe, p3DIm, p3DAbs, p3DArg} = \nPlot3D[Chop[# @ g[x, y]], {x1, -X1 + \
1/Pi \[CurlyEpsilon], X1}, {x2, -X2 + 1/E \[CurlyEpsilon], X2},  \n        \
Evaluate[Sequence @@\n         DeleteCases[{opts}, (removePolygonSize -> _) | \
(exponentDegrees -> _)]],\n         ClipFill -> None, DisplayFunction -> \
Identity,   \n                            PlotPoints -> 120]& /@ {Re, Im, \
Abs, Arg};  \n",
  StyleBox["(* the contour plots *)",
    FontWeight->"Plain"],
  "\n{cpRe, cpIm, cpAbs, cpArg} = \nListContourPlot[ArcTan[#[[1]]], MeshRange \
-> {{-X1, X1}, {-X2, X2}},\n                       Contours -> 20, \
ColorFunction -> (Hue[0.8 #]&),\n                       DisplayFunction -> \
Identity, RotateLabel -> False,\n                       FrameLabel -> \
Join[als, {None, None}],\n                       PlotRange -> All]& /@ \
{p3DRe, p3DIm, p3DAbs, p3DArg};     \n                       \n",
  StyleBox["(* better 3D plots *)",
    FontWeight->"Plain"],
  "\n{p3DRe, p3DIm, p3DAbs, p3DArg} = \nFunction[reimabsarg,\nShow[\n\
Plot3D[Chop[reimabsarg @ g[x, y]], ##, \n        Evaluate[Sequence @@\n       \
  DeleteCases[{opts}, (removePolygonSize -> _) | (exponentDegrees -> _)]],\n  \
       ClipFill -> None, DisplayFunction -> Identity,   \n                    \
        PlotPoints -> 60]& @@@\n{{{x1, -X1, -\[CurlyEpsilon]}, {x2, -X2, -\
\[CurlyEpsilon]}},\n {{x1, -X1, -\[CurlyEpsilon]}, {x2, \[CurlyEpsilon], \
X2}},\n {{x1, \[CurlyEpsilon], X1}, {x2, -X2, -\[CurlyEpsilon]}},\n {{x1, \
\[CurlyEpsilon], X1}, {x2, \[CurlyEpsilon], X2}}}]] /@ {Re, Im, Abs, Arg};    \
                     \n                                                      \
\n",
  StyleBox["(* show both *)",
    FontWeight->"Plain"],
  "\nShow[GraphicsArray[\n{Graphics3D[{EdgeForm[], re3DColor, \n  Z = \
ZR[p3DRe]/2; \n  removeBigzEqual0CrossingPolygons[#, Z]& @ \
Cases[Graphics3D[p3DRe],\n       _Polygon, \[Infinity]]}, AxesLabel -> \
Append[als, Re],\n       BoxRatios -> {1, 1, 0.6}, Axes -> True, PlotRange -> \
pR[p3DRe]], \n cpRe}]];\n \nShow[GraphicsArray[\nZ = ZR[p3DIm]/2; \n\
{Graphics3D[{EdgeForm[], im3DColor,  \n  removeBigzEqual0CrossingPolygons[#, \
Z]& @ Cases[Graphics3D[p3DIm],\n       _Polygon, \[Infinity]]}, AxesLabel -> \
Append[als, Im],\n       BoxRatios -> {1, 1, 0.6}, Axes -> True, PlotRange -> \
pR[p3DIm]], \n  cpIm}]];     \n  \nShow[GraphicsArray[\nZ = ZR[p3DAbs]/2; \n\
{Graphics3D[{EdgeForm[], abs3DColor, \n  removeBigzEqual0CrossingPolygons[#, \
Z]& @ Cases[Graphics3D[p3DAbs],\n       _Polygon, \[Infinity]]}, AxesLabel -> \
Append[als, Abs],\n       BoxRatios -> {1, 1, 0.6}, Axes -> True, PlotRange \
-> pR[p3DAbs]], \n cpAbs}]]; \n \nShow[GraphicsArray[\nZ = ZR[p3DArg]/2; \n\
{Graphics3D[{EdgeForm[], arg3DColor, \n  removeBigzEqual0CrossingPolygons[#, \
Z]& @ Cases[Graphics3D[p3DArg],\n       _Polygon, \[Infinity]]}, AxesLabel -> \
Append[als, Arg],\n       PlotRange -> 1.01 {-Pi, Pi}, \n       Ticks -> \
{Automatic, Automatic, {-Pi, 0, Pi}},\n       BoxRatios -> {1, 1, 0.6}, Axes \
-> True], cpArg}]];                  \n]"
}], "Input",
  InitializationCell->True]
}, Closed]],

Cell[CellGroupData[{

Cell["Circular contour plots", "Subsection"],

Cell["\<\
toDisk[\[Delta]_, Polygon[l_]] := Module[{rL, \[Delta]1, \
\[CurlyPhi]D, \[CurlyPhi]l}, 
   rL = Join @@ (If[(\[CurlyPhi]D = Sqrt[(#1 . #1 & )[Last[#1] - First[#1]]]) \
< \[Delta], 
         #1, \[Delta]1 = Last[#1] - First[#1]; \[CurlyPhi]l = Ceiling[\
\[CurlyPhi]D/\[Delta]]; 
          Table[#1[[1]] + i*(\[Delta]1/\[CurlyPhi]l), {i, 0, \[CurlyPhi]l}]] \
& ) /@ 
       N[Partition[Append[l, First[l]], 2, 1]]; 
    {Polygon[Apply[#2*{Cos[#1], Sin[#1]} & , rL, {1}]]}]\
\>", "Input",
  InitializationCell->True],

Cell["\<\
circularArgContourPlot[data_, cls_, rMax_] := 
Module[{n = Round[(Times @@ Dimensions[data])/cl], gr}, 
        m = Round[n/2]; 
      gr = Graphics[ListContourPlot[Arg[data] , 
         ContourLines -> False, MeshRange -> {{-Pi, Pi}, 
            {0, rMax}}, ColorFunction -> Hue, Contours -> cls, 
       ColorFunctionScaling -> False, Frame -> False, 
       DisplayFunction -> Identity,
       PlotRange -> {-Pi, Pi}, Background -> GrayLevel[1]]]; 
    DeleteCases[gr, DisplayFunction -> Identity, Infinity] /. 
     p_Polygon :> toDisk[0.01, p]]\
\>", "Input",
  InitializationCell->True]
}, Closed]],

Cell[CellGroupData[{

Cell["Digit expansions", "Subsection"],

Cell["\<\
Convergents[x_?NumberQ] := 
With[{cf = ContinuedFraction[x]},
Divide @@@ Transpose[(Last /@ 
   FoldList[{#1[[2]], #1[[3]], #2 #1[[3]] + #1[[2]]}&, #, 
       Rest[cf]])& /@ {{0, 1, cf[[1]]}, {1, 0, 1}}]]              \
\>", \
"Input",
  InitializationCell->True],

Cell["\<\
continuedInverseRoot[x_?Positive, \[Alpha]_, ord_?Positive] :=
Floor[Last /@ Drop[NestWhileList[
 {#[[1]] + 1, If[# != 0, #^(-1/\[Alpha]), C]&[#[[2]] - Floor[#[[2]]]]}&, 
 {0, x}, (#[[1]] < (ord + 1) && #[[2]] =!= C)&], -1]]\
\>", "Input",
  InitializationCell->True],

Cell["\<\
fromContinuedInverseRoot[l_List, \[Alpha]_?Positive] := 
 Fold[(#2 + #1^(-\[Alpha]))&, First[Reverse[l]], Rest[Reverse[l]]]\
\>", \
"Input",
  InitializationCell->True],

Cell["\<\
ContinuedCotangent[x_, n_] :=
Cot[Plus @@ MapIndexed[(-1)^(#2[[1]] - 1) #&, ArcCot[Last /@ 
NestList[Function[{a, b}, {#, Floor[#]}&[(a b + 1)/(a - b)]] @@ #&, 
         {x, Floor[x]}, n]]]]\
\>", "Input",
  InitializationCell->True],

Cell["\<\
EngelAList[c_, o_] := Prepend[First /@ 
      NestList[{Floor[# + 1], Together[#]}&[#[[2]]/(#[[1]] - #[[2]])]&,
               {Floor[1/(c - IntegerPart[c]) + 1], 1/(c - IntegerPart[c])}, o \
- 1],
               Floor[c]]\
\>", "Input",
  InitializationCell->True],

Cell["\<\
EngelPartialSumList[as_] := 
FoldList[Plus, as[[1]], 1/Rest[FoldList[Times, 1, Rest[as]]]]\
\>", "Input",
  InitializationCell->True],

Cell["\<\
\[DoubleStruckQ]SeriesTo\[DoubleStruckQ]Product[qSeries_SeriesData] \
:= 
     FixedPoint[Function[x, {First[x] #, Last[x] #}&[First[x] /. 
        {HoldPattern[SeriesData[q_, 0, {1, x:(0 ...), c_?(# != 0&), ___}, 0, \
n_, 1]] :>
                                          (1 - q^(Length[{x}] + 1))^c,
     HoldPattern[SeriesData[q_, 0, {1}, 0, n_, 1]] :> 1}]], {qSeries, 1}, 
               SameTest -> (First[#1] === First[#2]&)][[2]]^-1 /;
              MatchQ[qSeries, HoldPattern[SeriesData[_, 0, {1, _Integer ...}, \
0, _, 1]]]\
\>", "Input",
  InitializationCell->True]
}, Closed]],

Cell[CellGroupData[{

Cell["Digit related plots", "Subsection"],

Cell["\<\
makePiecewiseStraightLine[l_] := 
With[{\[CurlyEpsilon] = (Max[l] - Min[l])/10^10}, 
Line[Prepend[Flatten[{# - {\[CurlyEpsilon], 1}, #}& /@ 
             MapIndexed[{#1, #2[[1]]}&, l], 1], {0, 0}]]];\
\>", "Input",
  InitializationCell->True],

Cell["\<\
cumulativeDigitCountPlot[digitList_, base_, opts___] := 
Module[{fl, s1,  makeColoredCumulativeCountLines},
makePiecewiseStraightLine[l_] := 
With[{\[CurlyEpsilon] = (Max[l] - Min[l])/10^10}, 
Line[Prepend[Flatten[{# - {\[CurlyEpsilon], 1}, #}& /@ 
             MapIndexed[{#1, #2[[1]]}&, l], 1], {0, 0}]]];
fl = MapIndexed[{#1, #2[[1]]}&, digitList];
s1 = {#[[1, 1]], Last /@ #}& /@ Split[Sort[fl], #1[[1]] === #2[[1]]&];
makeColoredCumulativeCountLines[data_] := 
(maxD = Max[First /@ data]; maxN = Max[Rest /@ data];
 {Hue[0.78 #[[1]]/maxD], makePiecewiseStraightLine[#[[2]]]}& /@ data);
 Graphics[makeColoredCumulativeCountLines[s1], 
        PlotRange -> All, PlotRange -> All, Frame -> True, Axes -> False,
        FrameLabel -> {k, None}]];       \
\>", "Input",
  InitializationCell->True],

Cell["\<\
cumulativeAverageDeviationDigitCountPlot[digitList_, base_, \
opts___] := 
Module[{fl, s1, makePiecewiseStraightLine, makeColoredCumulativeCountLines},
fl = MapIndexed[{#1, #2[[1]]}&, digitList];
s1 = {#[[1, 1]], Last /@ #}& /@ Split[Sort[fl], #1[[1]] === #2[[1]]&];
makePiecewiseStraightLine[l_] := 
With[{\[CurlyEpsilon] = (Max[l] - Min[l])/10^10}, 
Line[Prepend[Flatten[{# - {\[CurlyEpsilon], 1}, #}& /@ 
     MapIndexed[{#1, #2[[1]] - #1/base}&, l], 1], {0, 0}]]];
makeColoredCumulativeCountLines[data_] := 
(maxD = Max[First /@ data]; maxN = Max[Rest /@ data];
 {Hue[0.8 #[[1]]/maxD], makePiecewiseStraightLine[#[[2]]]}& /@ data);
Graphics[makeColoredCumulativeCountLines[s1], 
        PlotRange -> All, PlotRange -> All, Frame -> True, Axes -> False]];   \
    \
\>", "Input",
  InitializationCell->True],

Cell["\<\
BarDiagram[data_, opts___] :=
Show[Graphics3D[{EdgeForm[Thickness[0.0001]],
SurfaceColor[Hue[0.12], Hue[0.02], 2.3],
 {Polygon /@ Flatten[
    MapThread[Join[#1, Reverse[#2]]&, #]& /@
        Partition[Partition[#, 2]& /@ #, 2], 1],
  Polygon /@ Flatten[
    MapThread[Join[#1, Reverse[#2]]&, #]& /@
       Partition[Partition[#, 2]& /@
         Join[{{1, 1, 0}#& /@ First[#]}, #,
              {{1, 1, 0}#& /@ Last[#]}], 2], 1],
  Polygon /@ Flatten[
    MapThread[Join[#1, Reverse[#2]]&, #]& /@
       Partition[Partition[#, 2]& /@
         Join[{{1, 1, 0}#& /@ First[#]}, #,
              {{1, 1, 0}#& /@ Last[#]}]&[
               Transpose[#]], 2], 1]}}&[
  MapIndexed[((Quotient[#2 - {1, 1}, 2] +
              Mod[#2 - {1, 1}, 2]) ~ Join ~ {#1})&,
             Flatten[{#, #}& /@ (Flatten /@ Map[{#, #}&,
             data, {2}]), 1], {2}]]], 
             PlotRange -> All, opts, 
             ViewPoint -> {-3, 1, 1.6},
             BoxRatios -> {1, 4, 1}, Axes -> True,
             AxesLabel -> {\"b\", \"k\", 
             Subsuperscript[\"d\", \"k\", \"b\"]}]\
\>", "Input",
  InitializationCell->True],

Cell["\<\
PascalTriangleDigitPlot[digitList_, base_] :=
Module[{jn, l1, fl, hexagon, m}, 
jn = Floor[(Sqrt[1 + 8 Length[digitList]] - 1)/2];
l1 = Take[digitList, jn (jn + 1)/2];
fl = Fold[{Append[#1[[1]], Take[#1[[-1]], #2]],
          Drop[#1[[2]], #2]}&, {{}, l1}, Range[jn]][[1]];
hexagon[x_, y_] =
Polygon[{x, y} + #& /@ (1/Sqrt[3] Table[{Cos[\[CurlyPhi]], Sin[\[CurlyPhi]]},
                        {\[CurlyPhi], Pi/2, 2Pi + Pi/2, 2Pi/6}])] // N;
Show[GraphicsArray[{
Graphics[
Table[{Hue[0.76 fl[[y, x]]/(base - 1)],
        hexagon[x - (y - 1)/2, -(y - 1) Sqrt[3]/2] // N},
      {y, 1, jn}, {x, 1, y}], AspectRatio -> Automatic,
                              PlotRange -> All],
Graphics[
Table[{GrayLevel[Mod[fl[[y, x]], 2]/2],
                 hexagon[x - (y - 1)/2, -(y - 1) Sqrt[3]/2] // N},
      {y, 1, jn}, {x, 1, y}], AspectRatio -> Automatic,
                              PlotRange -> All, PlotLabel->\"mod 2\"],  
Graphics[
Table[{GrayLevel[Mod[fl[[y, x]], 3]/3],
                 hexagon[x - (y - 1)/2, -(y - 1) Sqrt[3]/2] // N},
      {y, 1, jn}, {x, 1, y}], AspectRatio -> Automatic,
                              PlotRange -> All, PlotLabel->\"mod 3\"]}],
                              PlotLabel -> \"b=\" <> ToString[base]]   \
]\
\>", "Input",
  InitializationCell->True],

Cell["\<\
RasterGraphics[(state_)?MatrixQ, colors_Integer:2, opts___] := 
  Graphics[Raster[Reverse[1 - state/(colors - 1)]], 
   AspectRatio -> (AspectRatio /. {opts} /. AspectRatio -> Automatic), \
opts]\
\>", "Input",
  InitializationCell->True]
}, Closed]]
}, Closed]],

