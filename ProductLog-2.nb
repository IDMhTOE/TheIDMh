Cell["\<\
Clear[\[DoubleStruckD]\[DoubleStruckF], normalizedNewtonFlow];
\[DoubleStruckD]\[DoubleStruckF][z_] = -F[z]/D[F[z], z];
normalizedNewtonFlow[x_] := #/Abs[#]&[\[DoubleStruckD]\[DoubleStruckF][x]];
\
\>", "Input",
  GeneratedCell->False],

Cell["\<\
Off[NDSolve::\"mxst\"];
tab = Table[
ndsol = NDSolve[{z'[t] == normalizedNewtonFlow[z[t]], z[0] == (1 +  10^-6) \
Exp[I \[CurlyPhi]]},
\t             z, {t, -10, 10}, MaxSteps -> 10000, 
\t             PrecisionGoal -> 4, AccuracyGoal -> 4];
\t             
ParametricPlot[Evaluate[{Re[z[t]], Im[z[t]]} /. ndsol[[1]]],
               Evaluate[{t, Sequence @@ ndsol[[1, 1, 2, 1, 1]]}],
               PlotStyle -> {Hue[\[CurlyPhi]/(2Pi)]},
               DisplayFunction -> Identity], {\[CurlyPhi], 0, 2Pi, \
2Pi/47}];\
\>", "Input"],

