  "\ntruchetSegments[{{x0_, y0_}, 0}] := \n {Line[{{x0, y0} + {-1/2, 0}, {x0, \
y0} + {1/2, 0}}],\n  Line[{{x0, y0} + {0, -1/2}, {x0, y0} + {0, 1/2}}]}\n  \n\
truchetSegments[{{x0_, y0_}, -1}] := \n {Circle[{x0, y0} + {-1/2, +1/2}, 1/2, \
