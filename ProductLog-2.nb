function\
\>", "Subsection"],

Cell["\<\
 \[CurlyEpsilon] = 10^-6; T = 6; \[CurlyPhi] = 2;

EAPS[
{rePic, imPic} = 
Function[{reIm, pr}, 
 Fx[x_, y_] = -reIm[D[F[x + I y], x]];
 Fy[x_, y_] = -reIm[D[F[x + I y], y]];
 fAbs[x_, y_] = Sqrt[Fx[x, y]^2 + Fy[x, y]^2];

tab = Table[nsol = NDSolve[
{x'[t] == Fx[x[t], y[t]]/fAbs[x[t], y[t]],
 y'[t] == Fy[x[t], y[t]]/fAbs[x[t], y[t]],
 x[0] == 1 Cos[\[CurlyPhi]], y[0] == 1 Sin[\[CurlyPhi]]},
 {x, y}, {t, -T, T}];
 ParametricPlot[Evaluate[{x[t], y[t]} /. nsol], 
    Evaluate[{t, Sequence @@ nsol[[1,1,2,1,1]]}], DisplayFunction -> \
Identity, 
    PlotStyle -> {Hue[\[CurlyPhi]/(2Pi)]}] , {\[CurlyPhi], \[CurlyEpsilon], \
2Pi - \[CurlyEpsilon], (2Pi - 3\[CurlyEpsilon])/37}];
Show[{grayUnitCircleGraphics, tab}, 
              DisplayFunction -> $DisplayFunction,
     Axes -> False, Frame -> True, FrameTicks -> False, 
     AspectRatio -> Automatic, PlotRange -> pr]] @@@ 
      {{Re, {{-3, 3}, {-3, 3}}},  {Im, 4 {{-1, 1}, {-1, 1}}}}];\
\>", "Input"],

Cell["Show[GraphicsArray[{rePic, imPic}]];", "Input"],

