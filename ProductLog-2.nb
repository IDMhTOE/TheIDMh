Cell[CellGroupData[{

Cell["Tetraview plots", "Section"],

Cell[CellGroupData[{

Cell["Arguments as a function of the image", "Subsection"],

Cell["\<\
\[CurlyEpsilon] = 10^-9;
\[CurlyPhi]Ranges = (# + {+\[CurlyEpsilon], - \[CurlyEpsilon]})& /@ \
Partition[Table[k Pi, {k, -1, 1, 1/2}], 2, 1];\
\>", "Input"],

Cell["\<\
EAPS[
{pRe, pIm} = Function[reIm, Show[
(removeBigPolygons[#, 1]& @ 
 ParametricPlot3D[{Re[F[r Exp[I \[CurlyPhi]]]], Im[F[r Exp[I \[CurlyPhi]]]], \
reIm[r Exp[I \[CurlyPhi]]], 
                {EdgeForm[], SurfaceColor[Hue[ArcTan[r \
Sin[\[CurlyPhi]]]/(Pi/2)],
                                          Hue[ArcTan[r \
Sin[\[CurlyPhi]]]/(Pi/2)], 2.3]}}, 
                 {r, \[CurlyEpsilon], 6}, {\[CurlyPhi], ##}, DisplayFunction \
-> Identity,
               BoxRatios -> {1, 1, 1}, PlotPoints -> {15, 29}, 
               PlotRange -> All, Axes -> True]& @@@
               \[CurlyPhi]Ranges) /.  p_Polygon :>  makeDiamond[p],  
               DisplayFunction -> $DisplayFunction,
               Boxed -> False, Axes -> False]] /@ {Re, Im}];\
\>", "Input"],

Cell["Show[GraphicsArray[{pRe, pIm}]];", "Input"],

Cell[TextData[{
  "The above graphics of the ",
  "real part",
  " and ",
  "imaginary part",
  " over the ",
  Cell[BoxData[
      FormBox[
        RowBox[{"complex", 
          FormBox["z",
            "TraditionalForm"], "\[Hyphen]", "plane"}], TraditionalForm]]],
  " can be viewed as a ",
  "projection",
  " of the ",
  "surface",
  " in a ",
  "four\[Hyphen]dimensional",
  " space with ",
  "coordinates",
  " ",
  Cell[BoxData[
      FormBox[
        RowBox[{
          RowBox[{"{", 
            RowBox[{"z", ",", 
              RowBox[{"W", "(", "z", ")"}]}], "}"}], "\[Element]", 
          RowBox[{
            SuperscriptBox["\[DoubleStruckCapitalC]", "2"], "\[TildeEqual]", 
            SuperscriptBox["\[DoubleStruckCapitalR]", "4"]}]}], 
        TraditionalForm]]],
  ". This time, ",
  "projections",
  " into other ",
  "3D hyperplanes",
  " are shown. The left picture shows ",
  Cell[BoxData[
      FormBox[
        RowBox[{"Re", "(", "z", ")"}], TraditionalForm]]],
  " as a ",
  "function",
  " of ",
  Cell[BoxData[
      FormBox[
        RowBox[{"Re", "(", 
          RowBox[{"W", "(", "z", ")"}], ")"}], TraditionalForm]]],
  " and ",
  Cell[BoxData[
      FormBox[
        RowBox[{"Im", "(", 
          RowBox[{"W", "(", "z", ")"}], ")"}], TraditionalForm]]],
  ". The right picture shows ",
  Cell[BoxData[
      FormBox[
        RowBox[{"Im", "(", "z", ")"}], TraditionalForm]]],
  " as a ",
  "function",
  " of ",
  Cell[BoxData[
      FormBox[
        RowBox[{"Re", "(", 
          RowBox[{"W", "(", "z", ")"}], ")"}], TraditionalForm]]],
  " and ",
  Cell[BoxData[
      FormBox[
        RowBox[{"Im", "(", 
          RowBox[{"W", "(", "z", ")"}], ")"}], TraditionalForm]]],
  ". ",
  "Over the ",
  "image",
  " plane, the ",
  "real part",
  " and ",
  "imaginary part",
  " of the ",
  "argument",
  " are ",
  "single\[Hyphen]valued functions",
  "."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["Tetraview animation", "Subsection"],

Cell["\<\
rMax = 3/2 Pi; \[CurlyEpsilon] = 10^-12; 
\[CurlyPhi]Ranges = Partition[Table[k Pi, {k, -1/2, 3/2, 1/2}], 2, 1];
rRanges = {{\[CurlyEpsilon], 1 - \[CurlyEpsilon]}, {1 + \[CurlyEpsilon], \
rMax}};
ppr = 24; pp\[CurlyPhi] = 18;
dataL = 
Table[{r Cos[\[CurlyPhi]], r Sin[\[CurlyPhi]], Re[F[r Exp[I \[CurlyPhi]]]], \
Im[F[r Exp[I \[CurlyPhi]]]]} // N[#, 22]&,
              {r, \[CurlyEpsilon], rMax - \[CurlyEpsilon], (rMax - 2 \
\[CurlyEpsilon])/ppr}, 
              {\[CurlyPhi], #1 + \[CurlyEpsilon], #2 - \[CurlyEpsilon], (#2 - \
#1 - 2\[CurlyEpsilon])/pp\[CurlyPhi]}]& @@@ \[CurlyPhi]Ranges;\
\>", "Input"],

Cell["\<\
(* FullOptions[#, PlotRange]& /@ tps *)
tps = Show[removeBigPolygons[#, 0.5]& @ 
           TetraViewGraphics[dataL, #, 8, Boxed -> True, Axes -> True,
            PlotRange -> 5 {{-1, 1}, {-1, 1}, {-1, 1}}]]& /@ N[\
\[ScriptCapitalM]sAnd\[CurlyPhi]s[16]];\
\>", "Input"],

Cell[TextData[{
  "The above graphics of the ",
  "real part",
  " and ",
  "imaginary part",
  " over the ",
  Cell[BoxData[
      FormBox[
        RowBox[{"complex", 
          FormBox["z",
            "TraditionalForm"], "\[Hyphen]", "plane"}], TraditionalForm]]],
  " can be viewed as a ",
  "projection",
  " of the ",
  "surface",
  " in a ",
  "four\[Hyphen]dimensional",
  " space with ",
  "coordinates",
  " ",
  Cell[BoxData[
      FormBox[
        RowBox[{
          RowBox[{"{", 
            RowBox[{"z", ",", 
              RowBox[{"W", "(", "z", ")"}]}], "}"}], "\[Element]", 
          RowBox[{
            SuperscriptBox["\[DoubleStruckCapitalC]", "2"], "\[TildeEqual]", 
            SuperscriptBox["\[DoubleStruckCapitalR]", "4"]}]}], 
        TraditionalForm]]],
  ". This ",
  "tetraview",
  " animation shows ",
  "projections",
  " from the ",
  "rotating",
  " ",
  "four\[Hyphen]dimensional",
  " ",
  "hypersurface",
  " ",
  Cell[BoxData[
      FormBox[
        RowBox[{"{", 
          RowBox[{
            RowBox[{"Re", "(", "z", ")"}], ",", " ", 
            RowBox[{"Im", "(", "z", ")"}], ",", " ", 
            RowBox[{"Re", "(", 
              RowBox[{"f", "(", "z", ")"}], ")"}], ",", " ", 
            RowBox[{"Im", "(", 
              RowBox[{"f", "(", "z", ")"}], ")"}]}], "}"}], 
        TraditionalForm]]],
  " with ",
  Cell[BoxData[
      FormBox[
        RowBox[{
          RowBox[{"f", "(", "z", ")"}], "=", 
          RowBox[{"W", "(", "z", ")"}]}], TraditionalForm]]],
  ". The right legend indicates the current orientation of the ",
  "hypersurface",
  " in ",
  "4D",
  ". The coloring is according to the value of the ",
  "fourth dimension",
  "."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["Projective projections", "Subsection"],

Cell["\<\
\[CurlyEpsilon] = 10^-12;
{xMinGlobal, xMaxGlobal} = {-5, 5};
{yMinGlobal, yMaxGlobal} = {-5, 5};\
\>", "Input"],

Cell["\<\
plotDomains = Flatten[Outer[List, partitionAndShrink[
                Table[x, {x, xMinGlobal, xMaxGlobal, 1}], \[CurlyEpsilon]], 
               partitionAndShrink[
                Table[y, {y, yMinGlobal, yMaxGlobal}], \[CurlyEpsilon]], 1], \
1];\
\>", "Input"],

Cell["\<\
EAPS[
{rePic, imPic} = Function[{reim1, reim2}, 
Show[Graphics3D[{EdgeForm[], 
ParametricPlot3D[MapAt[SurfaceColor[Hue[#], Hue[#], 2.2]&, 
                       {x, y, reim1[F[x + I y]], reim2[F[x + I y]]}/
                          Sqrt[x^2 + y^2 + Re[F[x + I y]]^2 + Im[F[x + I \
y]]^2],
                          {4}],
                 Evaluate[{x, Sequence @@ #[[1]]}], Evaluate[{y, Sequence @@ \
#[[2]]}], 
                 PlotPoints -> 16, DisplayFunction -> Identity,
                 Compiled -> False][[1]]& /@ plotDomains} /. 
                                                        p_Polygon :> \
makeDiamond[p]],
                DisplayFunction -> $DisplayFunction, Boxed -> False,
                PlotRange -> All]] @@@ {{Re, Im}, {Im, Re}}];\
\>", "Input"],

Cell["Show[GraphicsArray[{rePic, imPic}]];", "Input"],

Cell[TextData[{
  "Surfaces",
  " ",
  Cell[BoxData[
      FormBox[
        RowBox[{
          RowBox[{"{", 
            RowBox[{"x", ",", "y", ",", 
              RowBox[{"Re", "(", 
                RowBox[{"f", "(", "z", ")"}], ")"}]}], "}"}], "/", 
          SuperscriptBox[
            RowBox[{"(", 
              RowBox[{
                SuperscriptBox[
                  RowBox[{
                  "\[LeftBracketingBar]", "z", "\[RightBracketingBar]"}], 
                  "2"], "+", 
                SuperscriptBox[
                  RowBox[{"\[LeftBracketingBar]", 
                    RowBox[{"f", "(", "z", ")"}], "\[RightBracketingBar]"}], 
                  "2"]}], ")"}], 
            RowBox[{"1", "/", "2"}]]}], TraditionalForm]]],
  " and ",
  Cell[BoxData[
      FormBox[
        RowBox[{
          RowBox[{"{", 
            RowBox[{"y", ",", 
              RowBox[{"Re", "(", 
                RowBox[{"f", "(", "z", ")"}], ")"}], ",", 
              RowBox[{"Im", "(", 
                RowBox[{"f", "(", "z", ")"}], ")"}]}], "}"}], "/", 
          SuperscriptBox[
            RowBox[{"(", 
              RowBox[{
                SuperscriptBox[
                  RowBox[{
                  "\[LeftBracketingBar]", "z", "\[RightBracketingBar]"}], 
                  "2"], "+", 
                SuperscriptBox[
                  RowBox[{"\[LeftBracketingBar]", 
                    RowBox[{"f", "(", "z", ")"}], "\[RightBracketingBar]"}], 
                  "2"]}], ")"}], 
            RowBox[{"1", "/", "2"}]]}], TraditionalForm]]],
  " (where ",
  Cell[BoxData[
      FormBox[
        RowBox[{"z", "=", 
          RowBox[{"x", "+", 
            RowBox[{"\[ImaginaryI]", " ", "y"}]}]}], TraditionalForm]]],
  " and ",
  Cell[BoxData[
      FormBox[
        RowBox[{
          RowBox[{"f", "(", "z", ")"}], "=", 
          RowBox[{"W", "(", "z", ")"}]}], TraditionalForm]]],
  ") as ",
  Cell[BoxData[
      FormBox["z", TraditionalForm]]],
  " ranges over the ",
  Cell[BoxData[
      FormBox[
        RowBox[{"complex", 
          FormBox["z",
            "TraditionalForm"], "\[Hyphen]", "plane"}], TraditionalForm]]],
  "."
}], "Text"],

