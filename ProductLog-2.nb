Cell[CellGroupData[{

Cell["Contour plots over the complex plane", "Section"],

Cell[CellGroupData[{

Cell["Real and imaginary parts over the complex plane", "Subsection"],

Cell["\<\
{xMinGlobal, xMaxGlobal} = {-3 NUx, 3 NUx};
{yMinGlobal, yMaxGlobal} = {-3 NUy, 3 NUy};
{xPlotPoints, yPlotPoints} = {451, 451};
xTicks = Table[{i NUx, i NUx}, {i, -3, 3}];
yTicks = Table[{i NUy, i NUy}, {i, -3, 3}];

contours = 15;

ppAux = xPlotPoints yPlotPoints;\
\>", "Input"],

Cell["\<\
data = Table[F[N[x+I y]], 
             {y, yMinGlobal, yMaxGlobal, (yMaxGlobal - \
yMinGlobal)/yPlotPoints},
             {x, xMinGlobal, xMaxGlobal, (xMaxGlobal - \
xMinGlobal)/xPlotPoints}];\
\>", "Input"],

Cell["\<\
EAPS[
{lcpRe, lcpIm} = 
 (cls = makeContours[#1[data], contours];
  ListContourPlot[#1[data],
   MeshRange -> {{xMinGlobal, xMaxGlobal}, {yMinGlobal, yMaxGlobal}},
   ContourShading -> False,  Contours -> cls,  AspectRatio -> Automatic,
   ContourStyle -> {{Thickness[0.002], #2}}])& @@@ {{Re, red}, {Im, blue}}];  \
        \
\>", "Input"],

Cell["\<\
Show[{lcpRe, lcpIm},
      DisplayFunction -> $DisplayFunction, FrameLabel -> {\"x\",\"y\"},
      FrameTicks -> {xTicks, yTicks, None, None}];\
\>", "Input"],

Cell[TextData[{
  "Contour plot",
  " of the ",
  "real part",
  " (red) and ",
  "imaginary part",
  " (blue) of ",
  Cell[BoxData[
      FormBox[
        RowBox[{"W", "(", "z", ")"}], TraditionalForm]]],
  " over the ",
  Cell[BoxData[
      FormBox[
        RowBox[{"complex", 
          FormBox["z",
            "TraditionalForm"], "\[Hyphen]", "plane"}], TraditionalForm]]],
  ". Here ",
  Cell[BoxData[
      FormBox[
        RowBox[{"z", "=", 
          RowBox[{"x", "+", 
            RowBox[{"\[ImaginaryI]", " ", "y"}]}]}], TraditionalForm]]],
  ". By the ",
  "Cauchy\[Dash]Riemann equations",
  ", the ",
  "curves",
  " of constant ",
  "real part",
  " and constant ",
  "imaginary part",
  " are ",
  "orthogonal",
  ". The ",
  "curves",
  " of constant ",
  "real part",
  " are ",
  "circles",
  " and the ",
  "curves",
  " of constant ",
  "imaginary part",
  " are ",
  "rays",
  "."
}], "Text"],

Cell["\<\
Show[
ListContourPlot[#1[data],
            MeshRange -> {{xMinGlobal, xMaxGlobal}, {yMinGlobal, \
yMaxGlobal}},
            DisplayFunction -> Identity, Contours -> {0}, 
            ContourShading -> False, ContourStyle -> {{Thickness[0.002], \
#2}}]& @@@
            {{Re, red}, {Im, blue}}, DisplayFunction -> $DisplayFunction,
            FrameLabel -> {\"x\",\"y\"},  FrameTicks -> {xTicks, yTicks, \
None, None},
            PlotRange -> {{xMinGlobal, xMaxGlobal}, {yMinGlobal, \
yMaxGlobal}}];\
\>", "Input"],

Cell[TextData[{
  "Curves",
  " of ",
  "vanishing",
  " ",
  "real part",
  " (red) and ",
  "imaginary part",
  " (blue) of ",
  Cell[BoxData[
      FormBox[
        RowBox[{"W", "(", "z", ")"}], TraditionalForm]]],
  " over the ",
  Cell[BoxData[
      FormBox[
        RowBox[{"complex", 
          FormBox["z",
