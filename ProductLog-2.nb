  StyleBox["(* argument and absolute value of the DFT of the function at \
Gaussian integers *)",
    FontWeight->"Plain"],
  "\nArgAbsFourierGraphics[F_, L_] := \nModule[{T, FT, AFT, AFTScaled},\nT = \
Table[F[N[x + I y]], {x, -L, L}, {y, -L, L}];\nFT = \
Fourier[Map[If[NumberQ[#], #, 0.+0.I]&, T, {2}]];\nAFT = Rationalize[Abs[FT], \
0];\n MapIndexed[(auxF[#1] = #2[[1]])&, Union[Sort[Flatten[AFT]]]];\n\
AFTScaled = Map[auxF, AFT, {2}];\nShow[GraphicsArray[\n\
Block[{$DisplayFunction = Identity},\n {ListDensityPlot[Arg[FT], Mesh -> \
False, \n                  MeshRange -> {{-L, L}, {-L, L}}, FrameTicks -> \
None,\n                  ColorFunction -> (Hue[0.78 #]&), PlotRange -> {-Pi, \
Pi}],\n  ListDensityPlot[AFTScaled, Mesh -> False, \n                  \
MeshRange -> {{-L, L}, {-L, L}}, FrameTicks -> None,\n                  \
ColorFunction -> (Hue[0.78 #]&), PlotRange -> All]}]]]];"
}], "Input",
  InitializationCell->True]
}, Closed]],

