}, Closed]],

Cell[TextData[{
  "The ",
  "real part",
  " and the ",
  "imaginary part",
  " of the ",
  "lattice sum",
  " ",
  Cell[BoxData[
      FormBox[
        RowBox[{
          SubsuperscriptBox["\[Sum]", 
            RowBox[{"j", "=", 
              RowBox[{"-", "o"}]}], "o"], 
          RowBox[{
            SubsuperscriptBox["\[Sum]", 
              RowBox[{"k", "=", 
                RowBox[{"-", "o"}]}], "o"], 
            RowBox[{"W", "(", 
              RowBox[{"z", "-", 
                RowBox[{"(", 
                  RowBox[{"j", "+", 
                    RowBox[{"\[ImaginaryI]", " ", "k"}]}], ")"}]}], ")"}]}]}],
         TraditionalForm]]],
  " in the ",
