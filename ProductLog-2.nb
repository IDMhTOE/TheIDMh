Table[removeLineJumps[#, 0.8]& @
ParametricPlot[Evaluate[{{Re @ F[\[Alpha] \[CurlyPhi]], Re @ F[\[Beta] \
\[CurlyPhi]]},
                         {Im @ F[\[Alpha] \[CurlyPhi]], Im @ F[\[Beta] \
\[CurlyPhi]]}}], {\[CurlyPhi], -3, 3},
               PlotStyle -> {red, blue}, PlotPoints -> 200,
               Frame -> True, PlotRange -> 3{{-1, 1}, {-1, 1}},
               Axes -> False, FrameTicks -> None,
               AspectRatio -> 1, DisplayFunction -> Identity,
               PlotLabel -> (\"m=\"<>ToString[\[Alpha]] <> \", n=\" <> \
ToString[\[Beta]]),
               PlotStyle -> {{Hue[0], Thickness[0.006]}}],
               {\[Alpha], 1, 5}, {\[Beta], 1, 5}]]];\
\>", "Input"],

