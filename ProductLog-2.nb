      FormBox[
        RowBox[{"Sign", "(", 
          RowBox[{
            StyleBox["Arg",
              "Traditional"], 
            StyleBox["(",
              "Traditional"], 
            RowBox[{
              StyleBox["log",
                "Traditional"], "(", 
              StyleBox["z",
                "Traditional"], 
              StyleBox[")",
                "Traditional"]}], 
