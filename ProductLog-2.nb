Cell[CellGroupData[{

Cell["Inside\[Dash]outside plots", "Section"],

Cell["\<\
ppr = 300; pp\[CurlyPhi] = 300; \[CurlyEpsilon] = 10.^-3; R = 1;
data = Table[F[If[r <= R, r, R^2/(2R - r)] Exp[I \[CurlyPhi]]], 
             {r, \[CurlyEpsilon], 2R - \[CurlyEpsilon], (2R - 2 \
\[CurlyEpsilon])/ppr}, {\[CurlyPhi], \[CurlyEpsilon], 2Pi - \[CurlyEpsilon], \
(2Pi - 2\[CurlyEpsilon])/(pp\[CurlyPhi])}]; \
\>", "Input",
  GeneratedCell->False],

Cell["\<\
{dataRe, dataIm} = {N[ArcTan[Re[data]]], \
N[ArcTan[Im[data]]]};\
\>", "Input",
  GeneratedCell->False],

