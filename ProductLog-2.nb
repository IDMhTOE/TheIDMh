      FormBox[
        RowBox[{
          SuperscriptBox["\[PartialD]", "\[Alpha]"], 
          RowBox[{
            RowBox[{"W", "(", "x", ")"}], "/", 
            RowBox[{"\[PartialD]", 
              SuperscriptBox["x", "\[Alpha]"]}]}]}], TraditionalForm]]],
  ". "
}], "Text"],

Cell["\<\
\[CurlyEpsilon] = 10^(-6); 
ParametricPlot3D[Evaluate[{\[Alpha]r*Cos[\[Alpha]\[CurlyPhi]], \[Alpha]r*Sin[\
\[Alpha]\[CurlyPhi]], Re @ FDeriv[\[Alpha]r Exp[I \[Alpha]\[CurlyPhi]], \
1/10], {EdgeForm[], SurfaceColor[Hue[\[Alpha]\[CurlyPhi]/(2 Pi)], 
         Hue[\[Alpha]\[CurlyPhi]/(2*Pi) + 1/2], 2.5]}}], 
   {\[Alpha]r, \[CurlyEpsilon], 6}, {\[Alpha]\[CurlyPhi], \[CurlyEpsilon], 2 \
Pi - \[CurlyEpsilon]}, PlotPoints -> 90, 
   BoxRatios -> {1, 1, 0.6}, PlotRange -> {-4, 4}, Axes -> False]; \
\>", \
"Input"],

Cell[TextData[{
  "Real part",
  " of the ",
  "fractional derivatives",
  " of ",
  Cell[BoxData[
      FormBox[
        RowBox[{
          SuperscriptBox["\[PartialD]", "\[Alpha]"], 
          RowBox[{
            RowBox[{"W", "(", "z", ")"}], "/", 
            RowBox[{"\[PartialD]", 
              SuperscriptBox["z", "\[Alpha]"]}]}], 
          RowBox[{"|", 
            SubscriptBox["", 
              RowBox[{"z", "=", 
                RowBox[{"1", "/", "10"}]}]]}]}], TraditionalForm]]],
  "over the ",
  Cell[BoxData[
      FormBox[
        RowBox[{"complex", 
          FormBox["\[Alpha]",
            "TraditionalForm"], "\[Hyphen]", "plane"}], TraditionalForm]]],
  "."
}], "Text"]
}, Closed]]
}, Closed]]
