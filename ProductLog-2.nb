Show[{grayUnitCircleGraphics, tab}, DisplayFunction -> \
$DisplayFunction,
          PlotRange -> 3 {{-1, 1}, {-1, 1}}, AspectRatio -> Automatic,
          Frame -> True, Axes -> False, FrameTicks -> False];\
\>", "Input"],

