Cell[CellGroupData[{

Cell["Offset curves", "Subsection"],

Cell["\<\
normalLineSegment[x_, {\[Lambda]M_, \[Lambda]P_}] = 
With[{dir = #/Sqrt[#.#]&[{F'[x], -1}]},
      Line[{{x, F[x]} + \[Lambda]M dir, {x, F[x]} + \[Lambda]P dir}]];\
\>", \
"Input"],

Cell["\<\
pp = 200;
curve = Table[{x, F[x]} // N, {x, -1/E, 6, NUx/pp}];\
\>", "Input"],

Cell["\<\
aux = {x, F[x]} + s #/Sqrt[#.#]&[{F'[x], -1}];
sol = Solve[Det[{D[aux, x], D[aux, s]}] == 0, s] // Simplify;
caustic[x_] = aux /. sol[[1]];\
\>", "Input"],

Cell["\<\
EAPS[
causticCurve = removeLineJumps[#, 1]& @ 
              ParametricPlot[Evaluate[caustic[x]], {x, -4 NUx, 4 NUx},
                    PlotPoints -> 200];
]\
\>", "Input"],

Cell["\<\
Off[Graphics::gptn];
Show[Graphics[{
{GrayLevel[0.6], Thickness[0.006], Line[curve]},
{Hue[0], Thickness[0.001], 
 Table[normalLineSegment[x, {-6, 6}], 
         {x, -2NUxMax NUx, 2NUxMax NUx, 2 2NUxMax NUx/120}]},
{RGBColor[0, 0, 1], Thickness[0.003], 
 Cases[causticCurve, _Line, \[Infinity]]}  }], 
         Frame -> True, PlotRange -> {{-5, 5}, {-5, 5}}, 
         AspectRatio -> Automatic,
         FrameTicks -> {Table[k, {k, -4, 6}], 
         Automatic, None, None}];
On[Graphics::gptn];         \
\>", "Input"],

Cell[TextData[{
  "Wavefront ",
  "caustic",
  " of the function ",
  Cell[BoxData[
      FormBox[
        RowBox[{
          RowBox[{"y", "(", "x", ")"}], "=", 
          RowBox[{"W", "(", "x", ")"}]}], TraditionalForm]]],
  ". The gray curve is the function ",
  Cell[BoxData[
      FormBox[
        RowBox[{"y", "(", "x", ")"}], TraditionalForm]]],
  ". The red lines are ",
  "normals",
  " on this curve. The blue curves are the ",
  "caustics",
  " formed by the ",
  "normals",
  "."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["Pursuit curves", "Subsection"],

Cell["\<\
xC[t_] = t; yC[t_] = Re @ F[t];

\[CurlyEpsilon] = 10^-12;
pursuitSol[{sx0_, sy0_}, T_] := 
NDSolve[
{sx'[t] == (xC[t] - sx[t])/Sqrt[(xC[t] - sx[t])^2 + (yC[t] - sy[t])^2],
 sy'[t] == (yC[t] - sy[t])/Sqrt[(xC[t] - sx[t])^2 + (yC[t] - sy[t])^2],
 sx[\[CurlyEpsilon]] == sx0, sy[\[CurlyEpsilon]] == sy0}, {sx, sy}, {t, \
\[CurlyEpsilon], T},
MaxSteps -> 10000, StoppingTest :> 
\t\t              ((xC[t] - sx[t])^2 + (yC[t] - sy[t])^2 < 10^-3)]\
\>", \
"Input",
  GeneratedCell->False],

Cell["\<\
pp = 200;
curve = Table[{x, Re @ F[x]} // N, {x, -1/E, 5, 1/pp}];\
\>", "Input"],

Cell["\<\
pp = 12;
Off[Less::nord]; Off[NDSolve::\"stopt\"]; Off[ParametricPlot::plld];
Off[InterpolatingFunction::dmval];
pCurves = Table[
pS = pursuitSol[{sx0, sy0}, 3 Pi]; 
ParametricPlot[Evaluate[{sx[t], sy[t]} /. pS[[1]] ],
               {t, 0, pS[[1, 1, 2, 1, 1, 2]]}, DisplayFunction -> Identity],
       {sx0, 0, 2, 2/pp}, {sy0, -1, 1, 2/pp}];
On[Less::nord]; On[NDSolve::\"stopt\"]; On[ParametricPlot::plld];
On[InterpolatingFunction::dmval];       \
\>", "Input"],

Cell["\<\
Off[Graphics::\"gptn\"];
gr0 = Show[Graphics[{
{Hue[0], Thickness[0.001], Cases[pCurves, _Line, \[Infinity]]},
{GrayLevel[0.6], Thickness[0.006], Line[curve]}}], 
         Frame -> True, PlotRange -> {{-1, 4}, {-3/2, 5/2}}, 
         AspectRatio -> Automatic,
         FrameTicks -> {Table[k, {k, -4, 4}], 
         Automatic, None, None}];
On[Graphics::\"gptn\"];         \
\>", "Input"],

Cell[TextData[{
  "Pursuit curves",
  " with respect to the function ",
  Cell[BoxData[
      FormBox[
        RowBox[{
          RowBox[{"y", "(", "x", ")"}], "=", 
          RowBox[{"W", "(", "x", ")"}]}], TraditionalForm]]],
  ". The gray curve is the function ",
  Cell[BoxData[
      FormBox[
        RowBox[{"y", "(", "x", ")"}], TraditionalForm]]],
  ". The red curves are ",
  "pursuit curves",
  " that start at different positions."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["Evolute", "Subsection"],

Cell["\<\
\[Rho][x_] = Abs[1/(F''[x]/(1 + F'[x]^2)^(3/2))];
evolute[x_] = {x, F[x]} + {-F'[x], 1}(1 + F'[x]^2)/F''[x];\
\>", "Input",
  GeneratedCell->False],

Cell["\<\
EAPS[
evoCurve = removeLineJumps[#, 4]& @ 
            ParametricPlot[Evaluate[evolute[x]], {x, -6, 6},
                    PlotPoints -> 200];]\
\>", "Input"],

Cell["\<\
pp = 1200;
curve = Table[{x, F[x]} // N, {x, -1/E, 8, 8/pp}];\
\>", "Input"],

Cell["\<\
Off[Graphics::\"gptn\"]; Off[Greater::\"nord\"]; \
Off[Less::\"nord\"]
pr = {{-2, 8}, {-6, 4}};
gr0 = Show[Graphics[{
{Thickness[0.001], 
 Table[{{Hue[0.12 ArcTan[\[Rho][t]]/(Pi/2)], circle[N @ evolute[t], N @ \
\[Rho][t], pr]},
        {RGBColor[0, 1, 0], Thickness[0.001], Line[{{t, F[t]}, \
evolute[t]}]}}, 
       {t, -1, 1, 1/40}]},
{GrayLevel[0.6], Thickness[0.006], Line[curve]},

{RGBColor[0, 0, 1], Thickness[0.003], Cases[evoCurve, _Line, \[Infinity]]}}], \

         Frame -> True, PlotRange -> pr, 
         AspectRatio -> Automatic,
         FrameTicks -> {Automatic, Automatic, None, None}];
On[Graphics::\"gptn\"]; On[Greater::\"nord\"]; On[Less::\"nord\"]        \
\
\>", "Input"],

Cell[TextData[{
  "Evolute",
  " and ",
  "osculating circles",
  " of the function ",
  Cell[BoxData[
      FormBox[
        RowBox[{
          RowBox[{"y", "(", "x", ")"}], "=", 
          RowBox[{"W", "(", "x", ")"}]}], TraditionalForm]]],
  ". The gray curve is the function ",
  Cell[BoxData[
      FormBox[
        RowBox[{"y", "(", "x", ")"}], TraditionalForm]]],
  ". The ",
  "osculating circles",
  " are colored according to their radius and the blue curve is the ",
  "evolute",
  ". The green lines connect the centers of the ",
  "osculating circles",
  " with the points where the circles touch the curve."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["Involutes", "Subsection"],

Cell["\<\
Clear[s, xyC, t, arcLength];

xyC[t_] = {t, F[t]};

arcLength = NDSolve[{s'[t] == Sqrt[1 + F'[t]^2], s[2] == 0}, s,
                    {t, -6, 6}][[1, 1, 2]];\
\>", "Input"],

Cell["\<\
pp = 200;
curveLine = Table[{x, F[x]} // N, {x, 0, 1, 1/pp}];\
\>", "Input"],

Cell["\<\
Off[InterpolatingFunction::\"dmval\"];
Off[InterpolatingFunction::\"dprec\"];
EAPS[
involutes = Table[
ParametricPlot[Evaluate[xyC[t] + 
               (arcLength[t] - arcLength[t0])  #/Sqrt[#.#]&[D[xyC[t], t]]],
               {t, -6, 6},
               DisplayFunction -> Identity], {t0, -6, 6, 12/60}];
]      
On[InterpolatingFunction::\"dmval\"];
On[InterpolatingFunction::\"dprec\"];        \
\>", "Input"],

Cell["EAPS[Show[involutes, DisplayFunction -> $DisplayFunction];]", "Input"],

Cell["\<\
Off[Graphics::gptn];
gr0 = Show[Graphics[{
 {red, Thickness[0.003], Cases[involutes, _Line, \[Infinity]]},
 {GrayLevel[0.6], Thickness[0.006], Line[curveLine]}}], 
         Frame -> True, PlotRange -> {{-6, 5}, {-10, 3}}, 
         AspectRatio -> Automatic,
         FrameTicks -> {Automatic,  Automatic, None, None}];
On[Graphics::gptn];         \
\>", "Input"],

Cell[TextData[{
  "Involutes",
  " of the function ",
  Cell[BoxData[
      FormBox[
        RowBox[{
          RowBox[{"y", "(", "x", ")"}], "=", 
          RowBox[{"W", "(", "x", ")"}]}], TraditionalForm]]],
  ". The gray curve is the function ",
  Cell[BoxData[
      FormBox[
        RowBox[{"y", "(", "x", ")"}], TraditionalForm]]],
  ". The ",
  "involutes",
  " are shown as red curves."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["Pedal curves", "Subsection"],

Cell["\<\
Clear[x, px, py];
pedal[x_, {px_, py_}] = {x, F[x]} + 
                        (1 (px - x) + F'[x] (py - F[x]))/(1 + F'[x]^2) {1, \
F'[x]};\
\>", "Input"],

Cell["\<\
pp = 12;
pedalCurves = Table[
           ParametricPlot[Evaluate[pedal[x, {px, py}]], {x, -4, 4},
                          DisplayFunction -> Identity, PlotPoints -> 200], 
                     {px, -Pi, Pi, 2Pi/pp}, {py, -Pi, Pi, 2Pi/pp}];\
\>", \
"Input"],

Cell["\<\
Show[Graphics[{Thickness[0.001], RGBColor[0, 1, 0], 
                 Cases[pedalCurves, _Line, \[Infinity]]}],
     AspectRatio -> Automatic, Frame -> True, FrameTicks -> False];\
\>", \
"Input"],

Cell[TextData[{
  "Family of ",
  "pedal curves",
  " of the function ",
  Cell[BoxData[
      FormBox[
        RowBox[{
          RowBox[{"y", "(", "x", ")"}], "=", 
          RowBox[{"W", "(", "x", ")"}]}], TraditionalForm]]],
  "."
}], "Text"],

Cell["\<\
contraPedal[x_, {px_, py_}] = {x, F[x]} + 
                              (1 (py - F[x]) + F'[x] (-px + x))/(1 + F'[x]^2) \
{-F'[x], 1};\
\>", "Input"],

Cell["\<\
pp = 9;
contraPedalCurves = Table[
           ParametricPlot[Evaluate[contraPedal[x, {px, py}]], {x, -8, 8},
                          DisplayFunction -> Identity, PlotPoints -> 200], 
                     {px, -Pi, Pi, 2Pi/pp}, {py, -Pi, Pi, 2Pi/pp}];\
\>", \
"Input"],

Cell["\<\
Show[Graphics[{Thickness[0.001], RGBColor[0, 1, 0], 
                 Cases[contraPedalCurves, _Line, \[Infinity]]}],
     AspectRatio -> Automatic, Frame -> True, FrameTicks -> False,
     PlotRange -> {{-6, 6}, {-6, 6}}];\
\>", "Input"],

Cell[TextData[{
  "Family of ",
  "contrapedal curves",
  " of the function ",
  Cell[BoxData[
      FormBox[
        RowBox[{
          RowBox[{"y", "(", "x", ")"}], "=", 
          RowBox[{"W", "(", "x", ")"}]}], TraditionalForm]]],
  "."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["Wavefront caustic surfaces", "Subsection"],

Cell["Clear[f, x, y, s];", "Input"],

Cell["\<\
pointsL = {x, y, f[x, y]} + s Cross[D[{x, y, f[x, y]}, x], D[{x, y, \
f[x, y]}, y]];\
\>", "Input"],

Cell["\<\
solSL = Solve[Det[{D[pointsL, x], D[pointsL, y], D[pointsL, s]}] == \
0, s] // 
                                                                     Simplify;\
\
\>", "Input"],

Cell["\<\
{fReRule, fImRule} = 
({Derivative[i_, j_][f][x, y] :> Re[D[F[x + I y], {x, i}, {y, j}]],
  f[x_, y] :> #[F[x + I y]]})& /@ {Re, Im};\
\>", "Input"],

Cell["\<\
pointsR[x_, y_, s_] = pointsL /. fReRule;
solSR[x_, y_] = s /. solSL /. fReRule;
causticPoints[{x_, y_}] := pointsR[x, y, #]& /@ Sort[solSR[x, y]];\
\>", \
"Input"],

Cell["\<\
gr3D1 = 
ParametricPlot3D[causticPoints[{x, y}][[1]], {x, -3, 3}, {y, -3, 3},
                 Compiled -> False, PlotPoints -> 90,
                 DisplayFunction -> Identity];
                 
gr3D1A = Show[gr3D1, PolygonIntersections -> False];\
\>", "Input"],

Cell["\<\
EAPS[gr3D1B =  
Show[Graphics3D[{EdgeForm[], SurfaceColor[red, Hue[0.12], 2.5], 
makeDiamond /@  Flatten[removeBigPolygons[Cases[gr3D1A, _Polygon, \
\[Infinity]], 30]]}],
   Ticks -> {Automatic, Automatic, None},
   Axes -> True, PlotRange -> {{-3, 3}, {0, 3}, {-8, 8}},
   BoxRatios -> {2, 1, 1}, ViewPoint -> {0, -4, 1}]];\
\>", "Input"],

Cell[CellGroupData[{

Cell["\<\
gr3D2 = 
ParametricPlot3D[causticPoints[{x, y}][[2]], {x, -2Pi, 2Pi}, {y, -Pi, Pi},
                 Compiled -> False, PlotPoints -> 90,
                 DisplayFunction -> Identity];
                 
gr3D2A = Show[gr3D2, PolygonIntersections -> False];\
\>", "Input"],

Cell[BoxData["$Aborted"], "Output"]
}, Closed]],

Cell["\<\
EAPS[gr3D2B =  
Show[Graphics3D[{EdgeForm[], SurfaceColor[red, Hue[0.12], 2.5], 
makeDiamond /@  Flatten[removeBigPolygons[Cases[gr3D2, _Polygon, \
\[Infinity]], 1]]}],
   Ticks -> {Automatic, Automatic, None},
   Axes -> True, PlotRange -> {{-3, 3}, {0, 3}, All},
   BoxRatios -> {2, 1, 1}, ViewPoint -> {0, -4, 1}]];\
\>", "Input"],

Cell["Show[GraphicsArray[{gr3D1B, gr3D2B}]];", "Input"],

Cell["\<\
pointsR[x_, y_, s_] = pointsL /. fImRule;
solSR[x_, y_] = s /. solSL /. fImRule;
causticPoints[{x_, y_}] := pointsR[x, y, #]& /@ Sort[solSR[x, y]];\
\>", \
"Input"],

Cell["\<\
gr3D1 = 
ParametricPlot3D[causticPoints[{x, y}][[1]], {x, -3, 3}, {y, -3, 3},
