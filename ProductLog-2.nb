  ". The left graphic shows the ",
  "real part",
  " and the right graphic shows the ",
  "imaginary part",
  "."
}], "Text"],

Cell["\<\
L = 3; \[CurlyEpsilon] = 10^-8;
Show[GraphicsArray[
Plot3D[Evaluate[ArcTan @ #[F[x + I y]^F[x + I y]]], {x, -3, 3}, {y, \
\[CurlyEpsilon], 3},
       PlotPoints -> 400, Mesh -> False, ViewPoint -> {0, -3, 1.4},
       DisplayFunction -> Identity, ClipFill -> None, PlotRange -> All,
        Ticks -> {Table[{i i, i}, {i, -3, 3, 3}],
                  Table[{i, i}, {i, 0, L}], Automatic} ]& /@ 
       {Re, Im}]];\
\>", "Input"],

