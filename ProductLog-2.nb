  {SurfaceColor[Pink, Pink, 2.1], EdgeForm[{}], 
   Cases[{fReTube1, fReTube2}, _Polygon, \[Infinity]]},
  {SurfaceColor[SkyBlue, SkyBlue, 2.1], EdgeForm[{}], 
   Cases[{fImTube1, fImTube2}, _Polygon, \[Infinity]]}}],
   BoxRatios -> {6, 2, 3}, ViewPoint -> {1, -3, 1},
   Axes -> True, AxesLabel -> {\"x\", \"y\", None}, PlotRange -> {-3.5, 3.5},
   Ticks -> {Table[i NUx, {i, -NUxMax, NUxMax}], {0, 1, 2}, Automatic},
   PlotRange -> {All, All, {-4, 4}}];\
\>", "Input"],

Cell["\<\
Show[Graphics3D[
 {{SurfaceColor[red, red, 2.1], EdgeForm[{Thickness[0.0001]}],
