Cell[CellGroupData[{

Cell["Differential geometry related functions", "Subsection"],

Cell[TextData[{
  StyleBox["(* plot a curve with intrinsic curvature f *)",
    FontWeight->"Plain"],
  "\nIntrinsicCurvaturePlot[f_, s0_:0, {x0_, y0_, \[CurlyTheta]0_}, \n        \
               {smin_, smax_}, color_, opts___] := \nModule[{x, y, \
\[CurlyTheta], s, ndsol},\n ndsol = {x[s], y[s]} /. (ndsolve=\n      \
NDSolve[{x'[s] == Cos[\[CurlyTheta][s]], y'[s] == Sin[\[CurlyTheta][s]], \n   \
           \[CurlyTheta]'[s] == f[s], x[s0] == x0, \n              y[s0] == \
y0, \[CurlyTheta][s0] == \[CurlyTheta]0}, {x, y, \[CurlyTheta]},  {s, smin, \
smax},\n              MaxSteps -> 10^4])[[1]];\n \
ParametricPlot[Evaluate[ndsol], {s, ndsol[[1, 0, 1, 1, 1]], ndsol[[1, 0, 1, \
1, 2]]}, \n                opts, PlotStyle -> {{Hue[color], \
Thickness[0.005]}},                    \n                PlotPoints -> 200, \
PlotRange -> All]]"
}], "Input",
  InitializationCell->True],

Cell["\<\
IntrinsicCurvatureTorsionPlot[{\[Kappa]_,\[Tau]_},
{a_:0, {p1_:0, p2_:0, p3_:0}, {q1_:1, q2_:0, q3_:0}, {r1_:0, r2_:0, r3_:1}},
{sMin_, sMax_}, color_, opts___] :=
Module[{x1, x2, x3, t1, t2, t3, n1, n2, n3, b1, b2, b3, ndsol, \[ScriptS]},
ndsol = {x1[s], x2[s], x3[s]} /.
NDSolve[{x1'[\[ScriptS]] == t1[\[ScriptS]], x2'[\[ScriptS]] == \
t2[\[ScriptS]], x3'[\[ScriptS]] == t3[\[ScriptS]], 
         t1'[\[ScriptS]] == \[Kappa][\[ScriptS]] n1[\[ScriptS]], t2'[\
\[ScriptS]] == \[Kappa][\[ScriptS]] n2[\[ScriptS]], t3'[\[ScriptS]] == \
\[Kappa][\[ScriptS]] n3[\[ScriptS]],
         n1'[\[ScriptS]] == -\[Kappa][\[ScriptS]] t1[\[ScriptS]] + \[Tau][\
\[ScriptS]] b1[\[ScriptS]],
         n2'[\[ScriptS]] == -\[Kappa][\[ScriptS]] t2[\[ScriptS]] + \[Tau][\
\[ScriptS]] b2[\[ScriptS]],
         n3'[\[ScriptS]] == -\[Kappa][\[ScriptS]] t3[\[ScriptS]] + \[Tau][\
\[ScriptS]] b3[\[ScriptS]],
         b1'[\[ScriptS]] == -\[Tau][\[ScriptS]] n1[\[ScriptS]],  b2'[\
\[ScriptS]] == -\[Tau][\[ScriptS]] n2[\[ScriptS]],  b3'[\[ScriptS]] == \
-\[Tau][\[ScriptS]] n3[\[ScriptS]],
         x1[a] == p1, x2[a] == p2, x3[a] == p3,
         t1[a] == q1, t2[a] == q2, t3[a] == q3,
         n1[a] == r1, n2[a] == r2, n3[a] == r3,
         b1[a] == q2 r3 - q3 r2,  b2[a] == q3 r1 - q1 r3, b3[a] == q1 r2 - q2 \
r1},
         {x1, x2, x3, t1, t2, t3, n1, n2, n3, b1, b2, b3},
         {\[ScriptS], sMin, sMax}, MaxSteps -> 10^4][[1]]; 
  ParametricPlot3D[Evaluate[Append[ndsol, {color, Thickness[0.002]}]], 
                  {s, ndsol[[1, 0, 1, 1, 1]], ndsol[[1, 0, 1, 1, 2]]}, 
                  opts, PlotPoints -> 400, PlotRange -> All, Compiled -> \
False]]       \
\>", "Input",
  InitializationCell->True]
}, Closed]],

