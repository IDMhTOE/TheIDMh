Cell[CellGroupData[{

Cell["Riemann surfaces", "Section"],

Cell["\<\
pl[f_, i_, {r_, \[CurlyPhi]_}] := 
  {-1/2/E + 1/2/E Cos[\[CurlyPhi]] Cosh[r], 1/2/E Sin[\[CurlyPhi]] Sinh[r],
\tf @ F[i, -1/2/E + 1/2/E Cos[\[CurlyPhi]] Cosh[r] + 
\t                         I 1/2/E Sin[\[CurlyPhi]] Sinh[r]]}
\[CurlyEpsilon] = 10^(-8); 
reRSF = EAPS[ Show[Graphics3D[
{SurfaceColor[red, Hue[0.12], 2.4], EdgeForm[], 
Cases[Table[{
ParametricPlot3D[Evaluate @ pl[Re, i, {r, \[CurlyPhi]}],
\t   {\[CurlyPhi], \[CurlyEpsilon], Pi - \[CurlyEpsilon]}, {r, \
\[CurlyEpsilon], 3}, DisplayFunction -> Identity],
ParametricPlot3D[Evaluate @ pl[Re, i + 1, {r, -\[CurlyPhi]}],
\t\t{\[CurlyPhi], \[CurlyEpsilon], Pi - \[CurlyEpsilon]}, {r, \
\[CurlyEpsilon], 3},
\tPlotRange -> All, DisplayFunction -> Identity]}, {i, -3, 3}], 
\t_Polygon, \[Infinity]]}],  
\tPlotRange -> {-8, 2}, BoxRatios -> {2, 1, 2}, 
\tAxes -> False, Boxed -> False] ];\
\>", "Input",
  GeneratedCell->False],

Cell["SideBarGraphics = reRSF;", "Input"],

Cell["\<\
imRSF = EAPS[ Show[Graphics3D[
{SurfaceColor[ blue, Hue[0.12],2.4], EdgeForm[], 
Cases[Table[{
ParametricPlot3D[Evaluate @ pl[Im, i, {r, \[CurlyPhi]}],
\t   {\[CurlyPhi], \[CurlyEpsilon], Pi - \[CurlyEpsilon]}, {r, \
\[CurlyEpsilon], 3}, DisplayFunction -> Identity],
ParametricPlot3D[Evaluate @ pl[Im, i + 1, {r, -\[CurlyPhi]}],
\t\t{\[CurlyPhi], \[CurlyEpsilon], Pi - \[CurlyEpsilon]}, {r, \
\[CurlyEpsilon], 3},
\tPlotRange -> All, DisplayFunction -> Identity]}, {i, -3, 3}], 
\t_Polygon, \[Infinity]]}],  
\tPlotRange -> All, BoxRatios -> {2, 1, 2}, 
\tAxes -> False, Boxed -> False] ];\
\>", "Input",
  GeneratedCell->False],

Cell["Show[GraphicsArray[{reRSF, imRSF}]];", "Input"],

Cell[TextData[{
  "Real part",
  " and ",
  "imaginary part",
  " of the ",
  "continuation",
  " of ",
  Cell[BoxData[
      FormBox[
        RowBox[{"W", "(", "z", ")"}], TraditionalForm]]],
  " over the ",
  Cell[BoxData[
      FormBox[
        RowBox[{"complex", 
          FormBox["z",
            "TraditionalForm"], "\[Hyphen]", "plane"}], TraditionalForm]]],
  ". The ",
