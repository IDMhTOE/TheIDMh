Cell[CellGroupData[{

Cell["Real part over the complex plane near infinity", "Subsection"],

Cell["\<\
{xMinGlobal, xMaxGlobal} = {-1, 1};
{yMinGlobal, yMaxGlobal} = {-1, 1};
{xPlotPoints, yPlotPoints} = {120, 120};
xTicks = Table[{i, i}, {i, -1, 1}];
yTicks = Table[{i, i}, {i, -1, 1}];\
\>", "Input"],

Cell["\<\
plotDomains = Flatten[Outer[List, partitionAndShrink[
                Table[x, {x, xMinGlobal, xMaxGlobal, 1}], 10^-10], 
                                  partitionAndShrink[
                Table[x, {x, yMinGlobal, yMaxGlobal}], 10^-10], 1], 1];\
\>", \
"Input"],

Cell["\<\
makeIterators[{{xMin_, xMax_}, {yMin_, yMax_}}] := 
Sequence[{x, xMin, xMax, (xMax - xMin)/
             Round[(xMax - xMin)/(xMaxGlobal - xMinGlobal) xPlotPoints]},
         {y, yMin, yMax, (yMax - yMin)/
             Round[(yMax - yMin)/(yMaxGlobal - yMinGlobal) \
yPlotPoints]}]\
\>", "Input"],

Cell["\<\
patchData = Table[{x, y, toMachineNumber @ N[F[N[1/(x + I y)]]]} // \
N, 
                  Evaluate @ makeIterators[#]]& /@ plotDomains;\
\>", "Input"],

Cell["\<\
{values[Re], values[Im], values[Abs]} = 
  (#[Last /@ Level[patchData, {-2}]])& /@ {Re, Im, Abs};\
\>", "Input"],

Cell["\<\
({min[#], max[#]} = {Min[values[#]], Max[values[#]]})& /@ \
ArcTan[{Re, Im, Abs}];
{min[Arg], max[Arg]} = {-Pi, Pi};\
\>", "Input"],

Cell["realPartPicturePair[patchData, {xTicks, yTicks}];", "Input"],

