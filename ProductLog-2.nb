}], "Text"],

Cell["\<\
Lx = 32; Ly = 8;
Show[Graphics[tab=
Table[truchetSegments[{{x, y}, 
          Mod[Round[(N[If[y === 0 && x >=0, 0, Arg[F[x + I y]]], 30] + 
                            Pi)/Pi/(1/10^10)], 3] - 1}],
      {x, -Lx, Lx}, {y, -Ly, Ly}]], AspectRatio -> Automatic, Frame -> True,
      FrameTicks -> {Lx {-1, 0, 1}, Ly {-1, 0, 1}, None, None}];\
\>", "Input"],

Cell[TextData[{
  "Truchet pattern",
  " of the form ",
  Cell[BoxData[
      FormBox[
        RowBox[{
          InterpretationBox[
            RowBox[{
              RowBox[{
                RowBox[{"\[LeftFloor]", 
                  RowBox[{
                    RowBox[{"Arg", 
                      RowBox[{"(", 
                        RowBox[{"log", 
                          RowBox[{"(", 
                            RowBox[{"x", "+", 
                              RowBox[{"\[ImaginaryI]", " ", "y"}]}], ")"}]}], 
                        ")"}]}], "+", "1"}]}], "\[RightCeiling]"}], " ", " ", 
              "mod", " ", " ", "3"}],
            Mod[ 
              Round[ 
                Times[ 10000000000, 
                  Power[ Pi, -1], 
                  Plus[ Pi, 
                    Arg[ 
                      Sin[ 
                        Plus[ x, 
                          Times[ 
                            Complex[ 0, 1.`30.], y]]]]]]], 3]], "-", "1"}], 
        TraditionalForm]]],
  "over the ",
  Cell[BoxData[
      FormBox[
        RowBox[{"complex", 
          FormBox["z",
            "TraditionalForm"], "\[Hyphen]", "plane"}], TraditionalForm]]],
  " at integer ",
  Cell[BoxData[
      FormBox["z", TraditionalForm]]],
  "\[Hyphen]values. ",
  " (Here ",
  Cell[BoxData[
      RowBox[{
        FormBox["\[LeftFloor]",
          "TraditionalForm"], "\[RightCeiling]"}]]],
  " is the round function.)"
}], "Text",
