\>", "Input"],

Cell[TextData[{
  "Upper picture: ",
  Cell[BoxData[
      FormBox[
        RowBox[{"W", "(", "z", ")"}], TraditionalForm]]],
  " in the ",
  "upper half",
  " of the ",
  Cell[BoxData[
      FormBox[
        RowBox[{"complex", 
          FormBox["z",
            "TraditionalForm"], "\[Hyphen]", "plane"}], TraditionalForm]]],
  " near the ",
  "real axis",
  " viewed from the ",
  "lower half\[Hyphen]plane",
  ". \nLower picture: ",
  Cell[BoxData[
      FormBox[
        RowBox[{"W", "(", "z", ")"}], TraditionalForm]]],
  " in the ",
  "lower half",
  " of the ",
  Cell[BoxData[
      FormBox[
        RowBox[{"complex", 
          FormBox["z",
            "TraditionalForm"], "\[Hyphen]", "plane"}], TraditionalForm]]],
  " near the ",
  "real axis",
  " viewed from the ",
  "upper half\[Hyphen]plane",
  ". \nHere the ",
  "complex variable",
  " ",
  Cell[BoxData[
      FormBox["z", TraditionalForm]]],
  " is expressed as ",
  Cell[BoxData[
      FormBox[
        RowBox[{"z", "=", 
          RowBox[{
            RowBox[{
              RowBox[{"Re", "(", "z", ")"}], "+", 
              RowBox[{"\[ImaginaryI]", " ", 
                RowBox[{"Im", "(", "z", ")"}]}]}], "=", 
            RowBox[{"x", "+", 
              RowBox[{"\[ImaginaryI]", " ", "y"}]}]}]}], TraditionalForm]]],
  ". The red ",
  "surface",
  " is the ",
  "real part",
  " of ",
  Cell[BoxData[
      FormBox[
        RowBox[{"W", "(", "z", ")"}], TraditionalForm]]],
  ". The blue, semitransparent ",
  "surface",
  " is the ",
  "imaginary part",
  " of ",
  Cell[BoxData[
      FormBox[
        RowBox[{"W", "(", "z", ")"}], TraditionalForm]]],
  ". The pink tube is the ",
  "real part",
  " of the ",
  "function",
  " ",
  Cell[BoxData[
      FormBox[
        RowBox[{"W", "(", "x", ")"}], TraditionalForm]]],
  " along the ",
  "real axis",
  " and the skyblue tube is the ",
  "imaginary part",
  " of the ",
  "function",
  " ",
  Cell[BoxData[
      FormBox[
        RowBox[{"W", "(", "x", ")"}], TraditionalForm]]],
  " along the ",
  "real axis",
  ". At ",
  Cell[BoxData[
      FormBox[
        RowBox[{"x", "=", 
          RowBox[{
            RowBox[{"-", "1"}], "/", "\[ExponentialE]"}]}], 
        TraditionalForm]]],
  ", the ",
  "function",
  " ",
  Cell[BoxData[
      FormBox[
        RowBox[{"W", "(", "x", ")"}], TraditionalForm]]],
  " has a ",
  "square root",
  " branch point",
  ". Along the ",
  "real axis",
  ", the ",
  "real part",
  " of ",
  Cell[BoxData[
      FormBox[
        RowBox[{"W", "(", "z", ")"}], TraditionalForm]]],
  " approaches ",
  Cell[BoxData[
      FormBox[
        RowBox[{"+", "\[Infinity]"}], TraditionalForm]]],
  " as ",
  Cell[BoxData[
      FormBox[
        RowBox[{"z", "\[Rule]", 
          RowBox[{"\[PlusMinus]", "\[Infinity]"}]}], TraditionalForm]]],
  ". Along the ",
  "real axis",
  ", the ",
  "imaginary part",
  " of ",
  Cell[BoxData[
      FormBox[
        RowBox[{"W", "(", "z", ")"}], TraditionalForm]]],
  " ",
  "vanishes identically",
  " for ",
  Cell[BoxData[
      FormBox[
        RowBox[{"x", "\[GreaterEqual]", 
          RowBox[{
            RowBox[{"-", "1"}], "/", "\[ExponentialE]"}]}], 
        TraditionalForm]]],
  "; going away from the ",
  "real axis",
  " into the ",
  Cell[BoxData[
      FormBox[
        RowBox[{"complex", 
          FormBox["z",
            "TraditionalForm"], "\[Hyphen]", "plane"}], TraditionalForm]]],
  " gives a function that approaches ",
  Cell[BoxData[
      FormBox[Cell["\[PlusMinus]\[Pi]/2"], TraditionalForm]]],
  ". The ",
  "imaginary part",
  " is ",
  "discontinuous",
  " along the ",
  "interval",
  " ",
  Cell[BoxData[
      FormBox[
        RowBox[{"(", 
          RowBox[{
            RowBox[{"-", "\[Infinity]"}], ",", 
            RowBox[{
              RowBox[{"-", "1"}], "/", "\[ExponentialE]"}]}], ")"}], 
        TraditionalForm]]],
  ". The ",
  "imaginary part",
  " has ",
  "upper lip continuity",
  "."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["Branch cuts", "Subsection"],

Cell["\<\
{xMinGlobal, xMaxGlobal} = {-2, 2};
{yMinGlobal, yMaxGlobal} = {-2, 2};
{xPlotPoints, yPlotPoints} = {30, 30};
xTicks = Table[{i, i}, {i, -2, 2}];
yTicks = Table[{i, i}, {i, -2, 2}];\
\>", "Input"],

Cell["\<\
plotDomains = Flatten[Outer[List, partitionAndShrink[
                Table[x, {x, xMinGlobal, xMaxGlobal, 1}], 10^-6], 
               partitionAndShrink[
                Table[y, {y, yMinGlobal, yMaxGlobal, 1}], 10^-6], 1], \
1];\
\>", "Input"],

Cell["\<\
makeIterators[{{xMin_, xMax_}, {yMin_, yMax_}}] := 
Sequence[{x, xMin, xMax, (xMax - xMin)/
             Round[(xMax - xMin)/(xMaxGlobal - xMinGlobal) xPlotPoints]},
         {y, yMin, yMax, (yMax - yMin)/
             Round[(yMax - yMin)/(yMaxGlobal - yMinGlobal) \
yPlotPoints]}]\
\>", "Input"],

Cell["\<\
patchData = Table[{x, y, F[N[x + I y]]} // N, 
                  Evaluate @ makeIterators[#]]& /@ plotDomains;\
\>", "Input"],

Cell["\<\
{pl3DRe, pl3DIm} = EAPS[
Show[Graphics3D[{
 antiColorEdges[#[patchData, {xTicks, yTicks}][[1, 1, 1]]]}], 
           BoxRatios -> {1, 1, 0.5}, Lighting -> True,
           Axes -> True, AxesLabel -> {\"x\", \"y\", #2},
           Ticks -> {xTicks, yTicks, Automatic},
           ViewPoint -> {1, -4, 1.9}]]& @@@
          { {realPartPicturePair, \"f\"}, {imaginaryPartPicturePair, \"g\"}};\
\
\>", "Input"],

Cell["Show[GraphicsArray[{pl3DRe, pl3DIm}]];", "Input"],

Cell[TextData[{
  "The ",
  "real part",
  " and the ",
  "imaginary part",
  " of ",
  Cell[BoxData[
      FormBox[
        RowBox[{"W", "(", "z", ")"}], TraditionalForm]]],
  " over the ",
  Cell[BoxData[
      FormBox[
        RowBox[{"complex", 
          FormBox["z",
            "TraditionalForm"], "\[Hyphen]", "plane"}], TraditionalForm]]],
  ". The left graphic shows ",
  Cell[BoxData[
      FormBox[
        RowBox[{"f", "=", 
          RowBox[{"Re", "(", 
            RowBox[{"W", "(", "z", ")"}], ")"}]}], TraditionalForm]]],
  " and the right graphic shows ",
  Cell[BoxData[
      FormBox[
        RowBox[{"g", "=", 
          RowBox[{"Im", "(", 
            RowBox[{"W", "(", "z", ")"}], ")"}]}], TraditionalForm]]],
  ". Along the ",
  "interval",
  " ",
  Cell[BoxData[
      FormBox[
        RowBox[{"(", 
          RowBox[{
            RowBox[{"-", "\[Infinity]"}], ",", 
            RowBox[{
              RowBox[{"-", "1"}], "/", "\[ExponentialE]"}]}], ")"}], 
        TraditionalForm]],
    AutoStyleOptions->{"UnmatchedBracketStyle"->None}],
  " the function ",
  Cell[BoxData[
      FormBox[
        RowBox[{"W", "(", "z", ")"}], TraditionalForm]]],
  " has a ",
  "branch cut",
  ". The ",
  "imaginary part",
  " has ",
  "discontinuities",
  " along the ",
  "branch cut",
  ". At ",
  Cell[BoxData[
      FormBox[
        RowBox[{"x", "=", 
          RowBox[{
            RowBox[{"-", "1"}], "/", "\[ExponentialE]"}]}], 
        TraditionalForm]]],
  ", the ",
  "function",
  " ",
  Cell[BoxData[
      FormBox[
        RowBox[{"W", "(", "x", ")"}], TraditionalForm]]],
  " has a ",
  "square root",
  " branch point",
  ". The viewpoint is from the ",
  "lower half\[Hyphen]plane",
  "."
}], "Text"],

Cell["\<\
{xMinGlobal, xMaxGlobal} = {-1/2, 1/2};
{yMinGlobal, yMaxGlobal} = {-1/2, 1/2};
{xPlotPoints, yPlotPoints} = {20, 20};
xTicks = Table[{i, i}, {i, -1/2, 1/2}];
yTicks = Table[{i, i}, {i, -1/2, 1/2}];\
\>", "Input"],

Cell["\<\
plotDomains = Flatten[Outer[List, partitionAndShrink[
                Table[x, {x, xMinGlobal, xMaxGlobal, 1/2}], 10^-12], 
               partitionAndShrink[
                Table[y, {y, yMinGlobal, yMaxGlobal, 1/2}], 10^-12], 1], \
1];\
\>", "Input"],

Cell["\<\
patchData = Table[{x, y, F[1/N[x + I y]]} // N, 
                  Evaluate @ makeIterators[#]]& /@ plotDomains;\
\>", "Input"],

Cell["\<\
{pl3DRe, pl3DIm} = EAPS[
Show[Graphics3D[{
 antiColorEdges[#[patchData, {xTicks, yTicks}][[1, 1, 1]]]}], 
           BoxRatios -> {1, 1, 0.5}, Lighting -> True,
           Axes -> True, AxesLabel -> {\"x\", \"y\", #2},
           Ticks -> {xTicks, yTicks, Automatic},
           ViewPoint -> {1, 4, 1.9}]]& @@@
          { {realPartPicturePair, \"f\"}, {imaginaryPartPicturePair, \"g\"}};\
\
\>", "Input"],

Cell["Show[GraphicsArray[{pl3DRe, pl3DIm}]];", "Input"],

Cell[TextData[{
  "The ",
  "real part",
  " and the ",
  "imaginary part",
  " of ",
  Cell[BoxData[
      FormBox[
        RowBox[{"W", "(", 
          RowBox[{"1", "/", "z"}], ")"}], TraditionalForm]]],
  " over the ",
  Cell[BoxData[
      FormBox[
        RowBox[{"complex", 
          FormBox["z",
            "TraditionalForm"], "\[Hyphen]", "plane"}], TraditionalForm]]],
  ". The left graphic shows ",
  Cell[BoxData[
      FormBox[
        RowBox[{"f", "=", 
          RowBox[{"Re", "(", 
            RowBox[{"W", "(", 
              RowBox[{"1", "/", "z"}], ")"}], ")"}]}], TraditionalForm]]],
  " and the right graphic shows ",
  Cell[BoxData[
      FormBox[
        RowBox[{"g", "=", 
          RowBox[{"Im", "(", 
            RowBox[{"W", "(", 
              RowBox[{"1", "/", "z"}], ")"}], ")"}]}], TraditionalForm]]],
  ". The viewpoint is from the ",
  "upper half\[Hyphen]plane",
  ". At ",
  Cell[BoxData[
      FormBox[
        RowBox[{"z", "=", "0"}], TraditionalForm]]],
  ", the function ",
  Cell[BoxData[
      FormBox[
        RowBox[{"W", 
          RowBox[{"(", 
            RowBox[{"1", "/", "z"}], ")"}]}], TraditionalForm]]],
  " has a ",
  "logarithmic singularity",
  "."
}], "Text"],

Cell["\<\
\[CurlyEpsilon] = 10^-8;
{xMin, xMax} = {-3, 3}; {yMin, yMax} = {-3, 3};
xTicks = Table[{i, i}, {i, xMin, xMax}];
yTicks = Table[{i, i}, {i, yMin, yMax}];

EAPS[
{rePic, imPic} = Function[{reIm, col, fg, pr}, 
Block[{$DisplayFunction = Identity}, 
bcsP3d = Graphics3D @ 
Plot3D[reIm[F[x + I y]], {x, xMin, xMax}, {y, -\[CurlyEpsilon], \
\[CurlyEpsilon]}, PlotPoints -> {31, 2}];
bcsF3d = Graphics3D /@ 
{Plot3D[reIm[F[x + I y]], {x, xMin, xMax}, {y, yMin, -\[CurlyEpsilon]},  \
PlotPoints -> {16, 31}],
 Plot3D[reIm[F[x + I y]], {x, xMin, xMax}, {y, \[CurlyEpsilon], yMax},  \
PlotPoints -> {16, 31}]}];
Show[Graphics3D[{
{SurfaceColor[col, col, 2.5], EdgeForm[], 
 Cases[Graphics3D[bcsP3d], _Polygon, \[Infinity]]},
{GrayLevel[1/2], Thickness[0.001], 
 Cases[bcsF3d, _Polygon, \[Infinity]] /. Polygon[l_] :> Line[Append[l, \
First[l]]]}
 }], PlotRange -> {{xMin, xMax}, {yMin, yMax}, pr},
     Axes -> True, AxesLabel -> {\"x\", \"y\", fg},
     Ticks -> {xTicks, yTicks, Automatic}, 
     ViewPoint -> {1, -4, 1}, BoxRatios -> {1, 1, 1/2}]] @@@ 
     {{Re, red, \"f\",  {-2, 1}}, {Im, Blue, \"g\", All}}];\
\>", "Input"],

Cell["Show[GraphicsArray[{rePic, imPic}]];", "Input"],

Cell[TextData[{
  "The ",
  "branch cuts",
  " of the ",
  "real part",
  " and the ",
  "imaginary part",
  " of ",
  Cell[BoxData[
      FormBox[
        RowBox[{"W", "(", "z", ")"}], TraditionalForm]]],
  " over the ",
  Cell[BoxData[
      FormBox[
        RowBox[{"complex", 
          FormBox["z",
            "TraditionalForm"], "\[Hyphen]", "plane"}], TraditionalForm]]],
  ". The left graphic shows ",
  Cell[BoxData[
      FormBox[
        RowBox[{"f", "=", 
          RowBox[{"Re", "(", 
            RowBox[{"W", "(", "z", ")"}], ")"}]}], TraditionalForm]]],
  " and the right graphic shows ",
  Cell[BoxData[
      FormBox[
        RowBox[{"g", "=", 
          RowBox[{"Im", "(", 
            RowBox[{"W", "(", "z", ")"}], ")"}]}], TraditionalForm]]],
  ". The red and blue vertical ",
  "surfaces",
  " connect points from the immediate lower and upper ",
  "neighborhoods",
  " of the ",
  "branch cuts",
  ". The ",
  "branch point",
  " at ",
  Cell[BoxData[
      FormBox[
        RowBox[{"z", "=", 
          RowBox[{
            RowBox[{"-", "1"}], "/", "\[ExponentialE]"}]}], 
        TraditionalForm]]],
  " is a ",
  "square root",
  " branch point",
  ". Only the ",
  "imaginary part",
  " shows ",
  "discontinuities",
  " due to the ",
  "branch cut",
  ". The viewpoint is from the ",
  "lower half\[Hyphen]plane",
  ". "
}], "Text"],

Cell["\<\
\[CurlyEpsilon] = 10^-8;
{xMin, xMax} = {-1, 1}; {yMin, yMax} = {-1, 1};
xTicks = Table[{i, i}, {i, xMin, xMax}];
yTicks = Table[{i, i}, {i, yMin, yMax}];

EAPS[
{rePic, imPic} = Function[{reIm, col, fg, pr}, 
Block[{$DisplayFunction = Identity}, 
bcsP3d = Graphics3D @ 
Plot3D[reIm[F[1/(x + I y)]], {x, xMin, xMax}, {y, -\[CurlyEpsilon], \
\[CurlyEpsilon]}, PlotPoints -> {31, 2}];
bcsF3d = Graphics3D /@ 
{Plot3D[reIm[F[1/(x + I y)]], {x, xMin, xMax}, {y, yMin, -\[CurlyEpsilon]},  \
PlotPoints -> {16, 31}],
 Plot3D[reIm[F[1/(x + I y)]], {x, xMin, xMax}, {y, +\[CurlyEpsilon], yMax},  \
PlotPoints -> {16, 31}]}];
Show[Graphics3D[{
{SurfaceColor[col, col, 2.5], EdgeForm[], 
 Cases[Graphics3D[bcsP3d], _Polygon, \[Infinity]]},
{GrayLevel[1/2], Thickness[0.001], 
 Cases[bcsF3d, _Polygon, \[Infinity]] /. Polygon[l_] :> Line[Append[l, \
First[l]]]}
 }], PlotRange -> {{xMin, xMax}, {yMin, yMax}, pr},
     Axes -> True, AxesLabel -> {\"x\", \"y\", fg},
     Ticks -> {xTicks, yTicks, Automatic},
     ViewPoint -> {1, 4, 1}, BoxRatios -> {1, 1, 1/2}]] @@@ 
     {{Re, Red, \"f\", {0, 2}}, {Im, Blue, \"g\", All}}];\
\>", "Input"],

Cell["Show[GraphicsArray[{rePic, imPic}]];", "Input"],

Cell[TextData[{
  "The ",
  "branch cuts",
  " of the ",
  "real part",
  " and the ",
  "imaginary part",
  " of ",
  Cell[BoxData[
      FormBox[
        RowBox[{"W", "(", 
          RowBox[{"1", "/", "z"}], ")"}], TraditionalForm]]],
  " over the ",
  Cell[BoxData[
      FormBox[
        RowBox[{"complex", 
          FormBox["z",
            "TraditionalForm"], "\[Hyphen]", "plane"}], TraditionalForm]]],
  ". The left graphic shows ",
  Cell[BoxData[
      FormBox[
        RowBox[{"f", "=", 
          RowBox[{"Re", "(", 
            RowBox[{"W", "(", 
              RowBox[{"1", "/", "z"}], ")"}], ")"}]}], TraditionalForm]]],
  " and the right graphic shows ",
  Cell[BoxData[
      FormBox[
        RowBox[{"g", "=", 
          RowBox[{"Im", "(", 
            RowBox[{"W", "(", 
              RowBox[{"1", "/", "z"}], ")"}], ")"}]}], TraditionalForm]]],
  ". The red and blue vertical ",
  "surfaces",
  " connect points from the immediate lower and upper ",
  "neighborhoods",
  " of the ",
  "branch cuts",
  ". The viewpoint is from the ",
  "upper half\[Hyphen]plane",
  "."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["Real part over the complex plane", "Subsection"],

Cell["\<\
{xMinGlobal, xMaxGlobal} = {-3, 3};
{yMinGlobal, yMaxGlobal} = {-3, 3};
{xPlotPoints, yPlotPoints} = {120, 120};
xTicks = Table[{i, i}, {i, -3, 3}];
yTicks = Table[{i, i}, {i, -3, 3}];\
\>", "Input"],

Cell["\<\
plotDomains = Flatten[Outer[List, partitionAndShrink[
                Table[x, {x, xMinGlobal, xMaxGlobal, 1}], 10^-6], 
               partitionAndShrink[
                Table[y, {y, yMinGlobal, yMaxGlobal, 1}], 10^-6], 1], \
1];\
\>", "Input"],

Cell["\<\
makeIterators[{{xMin_, xMax_}, {yMin_, yMax_}}] := 
Sequence[{x, xMin, xMax, (xMax - xMin)/
             Round[(xMax - xMin)/(xMaxGlobal - xMinGlobal) xPlotPoints]},
         {y, yMin, yMax, (yMax - yMin)/
             Round[(yMax - yMin)/(yMaxGlobal - yMinGlobal) \
yPlotPoints]}]\
\>", "Input"],

Cell["\<\
patchData = Table[{x, y, toMachineNumber @ N[F[N[x + I y]]]} // N, 
                  Evaluate @ makeIterators[#]]& /@ plotDomains;\
\>", "Input"],

Cell["realPartPicturePair[patchData, {xTicks, yTicks}];", "Input"],

Cell[TextData[{
  "The ",
  "real part",
  " of ",
  Cell[BoxData[
      FormBox[
        RowBox[{"W", "(", "z", ")"}], TraditionalForm]]],
  " where ",
  Cell[BoxData[
      FormBox[
        RowBox[{"z", "=", 
          RowBox[{"x", "+", 
            RowBox[{"\[ImaginaryI]", " ", "y"}]}]}], TraditionalForm]]],
  ". The ",
  "surface",
  " is colored according to the ",
  "imaginary part",
  ". The right graphic is a ",
  "contour plot",
  " of the scaled ",
  "real part",
  ", meaning the height values of the left graphic translate into color \
values in the right graphic. Red is smallest and violet is largest. The ",
  "function",
  " ",
  Cell[BoxData[
      FormBox[
        RowBox[{"W", "(", "z", ")"}], TraditionalForm]]],
  " has a ",
  "square root",
  " branch point",
  " at ",
  Cell[BoxData[
      FormBox[
        RowBox[{"z", "=", 
          RowBox[{
            RowBox[{"-", "1"}], "/", "\[ExponentialE]"}]}], 
        TraditionalForm]]],
  "; going away from the ",
  "real axis",
  " into the ",
  "upper half",
  " of the ",
  Cell[BoxData[
      FormBox[
        RowBox[{"complex", 
          FormBox["z",
            "TraditionalForm"], "\[Hyphen]", "plane"}], TraditionalForm]]],
  " gives a ",
  "function",
  " that asymptotically approaches \[Infinity]."
}], "Text"],

