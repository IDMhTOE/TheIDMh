Cell[CellGroupData[{

Cell["Polar and spherical plots", "Section"],

Cell["\<\
Show[GraphicsArray[Partition[Table[
removeLineJumps[#, 2]& @ ParametricPlot[
  Evaluate[{Re[F[k \[CurlyPhi]]] Cos[\[CurlyPhi]], Re[F[k \[CurlyPhi]]] Sin[\
\[CurlyPhi]]}], {\[CurlyPhi], -3, 3, 1}, 
       Frame -> True, Axes -> False, PlotRange -> All,
       PlotPoints -> 120,
       DisplayFunction -> Identity, PlotLabel -> \"k=\" <> ToString[k],
       PlotStyle -> {{Hue[0], Thickness[0.01]}},
       FrameTicks -> {Automatic, Automatic, None, None},
       AspectRatio -> 1], {k, 9}], 3]]];\
\>", "Input"],

Cell[TextData[{
  "Polar plots",
  " of the ",
  "function",
  " ",
  Cell[BoxData[
      FormBox[
        RowBox[{"W", "(", 
          RowBox[{"k", " ", "\[CurlyPhi]"}], ")"}], TraditionalForm]]],
  ". "
}], "Text"],

Cell["\<\
\[CurlyEpsilon] = 10^-10;
\[CurlyPhi]Ranges = (# + {+\[CurlyEpsilon], - \[CurlyEpsilon]})& /@ \
Partition[Table[k, {k, -6, 6, 6}], 2, 1];\
\>", "Input"],

Cell["\<\
Clear[\[Alpha], \[CurlyPhi]]; \[Alpha]Max = 6;
Show[GraphicsArray[
Function[reIm, 
Show[Table[ParametricPlot3D[
      Evaluate[{reIm[F[\[Alpha] \[CurlyPhi]]] Cos[\[CurlyPhi]], reIm[F[\
\[Alpha] \[CurlyPhi]]] Sin[\[CurlyPhi]], \[Alpha], {Hue[0.8 \
\[Alpha]/\[Alpha]Max]}}],
               {\[CurlyPhi], ##}, PlotPoints -> Ceiling[\[Alpha] + 1] 30,
               DisplayFunction -> Identity]& @@@
               \[CurlyPhi]Ranges, {\[Alpha], \[Alpha]Max/36, \[Alpha]Max, \
\[Alpha]Max/36}],
               Axes -> False, AspectRatio -> Automatic, BoxRatios -> {1, 1, \
2}]] /@
               {Re, Im}]];\
\>", "Input"],

Cell[TextData[{
  "Staggered ",
  "polar plots",
  " of the ",
  "function",
  " ",
  Cell[BoxData[
      FormBox[
        RowBox[{"Re", "(", 
          RowBox[{"W", "(", 
            RowBox[{"\[Alpha]", " ", "x"}], ")"}], ")"}], TraditionalForm]]],
  " and ",
  Cell[BoxData[
      FormBox[
        RowBox[{"Im", "(", 
          RowBox[{"W", "(", 
            RowBox[{"\[Alpha]", " ", "x"}], ")"}], ")"}], TraditionalForm]]],
  ". ",
  Cell[BoxData[
      FormBox["\[Alpha]", TraditionalForm]]],
  " increases vertically from 1 to 6. "
}], "Text"],

Cell["\<\
\[CurlyEpsilon] = 10^-2;
\[CurlyPhi]Ranges = Prepend[# + {+\[CurlyEpsilon], -\[CurlyEpsilon]}, \
\[CurlyPhi]]& /@ Partition[Table[\[CurlyPhi], {\[CurlyPhi], 0, 2Pi, Pi/2}], \
2, 1];
\[CurlyTheta]Ranges = Prepend[# + {+\[CurlyEpsilon], -\[CurlyEpsilon]}, \
\[CurlyTheta]]& /@ Partition[Table[\[CurlyTheta], {\[CurlyTheta], 0, Pi, \
Pi/2}], 2, 1];
\[CurlyPhi]\[CurlyTheta]Ranges = Flatten[Outer[List, \[CurlyPhi]Ranges, \
\[CurlyTheta]Ranges, 1], 1];\
\>", "Input"],

Cell["\<\
EAPS[
{pp3DRe, pp3DIm} = Function[reIm,
pp3D = ParametricPlot3D[Evaluate[{reIm[F[\[CurlyPhi] + I \[CurlyTheta]]] Cos[\
\[CurlyPhi]] Sin[\[CurlyTheta]], 
                                  reIm[F[\[CurlyPhi] + I \[CurlyTheta]]] Sin[\
\[CurlyPhi]] Sin[\[CurlyTheta]], 
                                  reIm[F[\[CurlyPhi] + I \[CurlyTheta]]] Cos[\
\[CurlyTheta]],
                                  {EdgeForm[Thickness[0.001]],
                                  SurfaceColor[Hue[#], Hue[#], 2.3]&[
                                    (ArcTan[Complement[{Re, Im}, \
{reIm}][[1]][
                                                  F[\[CurlyPhi] + I \
\[CurlyTheta]]]] + Pi/2)/Pi]}}],
                        ##, PlotPoints -> {18, 18},
                        PlotRange -> All, BoxRatios -> {1, 1, 1}, 
                        Axes -> True]& @@@ \[CurlyPhi]\[CurlyTheta]Ranges;
Show[pp3D /. p_Polygon :> makeDiamond[p], Axes -> False, Boxed -> False,
              DisplayFunction -> Identity]] /@ {Re, Im}];\
\>", "Input"],

Cell["Show[GraphicsArray[{pp3DRe, pp3DIm}]];", "Input"],

Cell[TextData[{
  "Spherical plot",
  " of the ",
  "functions",
  " ",
  Cell[BoxData[
      FormBox[
        RowBox[{"Re", "(", 
          RowBox[{"W", "(", 
            RowBox[{"\[CurlyPhi]", "+", 
              RowBox[{"\[ImaginaryI]", " ", "\[CurlyTheta]"}]}], ")"}], ")"}],
         TraditionalForm]]],
  " and ",
  Cell[BoxData[
      FormBox[
        RowBox[{"Im", "(", 
          RowBox[{"W", "(", 
            RowBox[{"\[CurlyPhi]", "+", 
              RowBox[{"\[ImaginaryI]", " ", "\[CurlyTheta]"}]}], ")"}], ")"}],
         TraditionalForm]]],
  ". The coloring is according to ",
  Cell[BoxData[
      FormBox[
        RowBox[{"Im", "(", 
          RowBox[{"W", "(", 
            RowBox[{"\[CurlyPhi]", "+", 
              RowBox[{"\[ImaginaryI]", " ", "\[CurlyTheta]"}]}], ")"}], ")"}],
         TraditionalForm]]],
  " and ",
  Cell[BoxData[
      FormBox[
        RowBox[{"Re", "(", 
          RowBox[{"W", "(", 
            RowBox[{"\[CurlyPhi]", "+", 
              RowBox[{"\[ImaginaryI]", " ", "\[CurlyTheta]"}]}], ")"}], ")"}],
         TraditionalForm]]],
  "."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["P\[OAcute]lya plots", "Section"],

Cell["\<\
{xMinGlobal, xMaxGlobal} = {-2, 2};
{yMinGlobal, yMaxGlobal} = {-2, 2};
{xPlotPoints, yPlotPoints} = {50, 30};
xTicks = Table[{i , i}, {i, -2, 3}];
yTicks = Table[{i, i}, {i, -3, 3}];\
\>", "Input"],

Cell["\<\
plotDomains = Flatten[Outer[List, partitionAndShrink[
                Table[x, {x, xMinGlobal, xMaxGlobal, 1/2}], 10^-6], 
               partitionAndShrink[
                Table[x, {x, yMinGlobal, yMaxGlobal}], 10^-6], 1], 1];\
\>", \
"Input"],

Cell["\<\
makeIterators[{{xMin_, xMax_}, {yMin_, yMax_}}] := 
Sequence[{x, xMin, xMax, (xMax - xMin)/
             Round[(xMax - xMin)/(xMaxGlobal - xMinGlobal) xPlotPoints]},
         {y, yMin, yMax, (yMax - yMin)/
             Round[(yMax - yMin)/(yMaxGlobal - yMinGlobal) \
yPlotPoints]}]\
\>", "Input"],

Cell["\<\
patchData = Table[{x, y, F[N[x + I y]]} // N, 
                  Evaluate @ makeIterators[#]]& /@ plotDomains;\
\>", "Input"],

Cell["\<\
Show[Graphics[{darkGreen, (makeP\[OAcute]lyaArrow[#, 0.08]& /@ \
Flatten[#, 1])& /@ patchData}], 
     AspectRatio -> Automatic, Frame -> True,
     FrameTicks -> {xTicks, yTicks, None, None}];\
\>", "Input"],

Cell[TextData[{
  "P\[OAcute]lya plot",
  " of ",
  Cell[BoxData[
      FormBox[
        RowBox[{"W", "(", "z", ")"}], TraditionalForm]]],
  ". The individual arrows have the ",
  "direction",
  " ",
  Cell[BoxData[
      FormBox[
        RowBox[{"{", 
          RowBox[{
            RowBox[{"Re", "(", 
              RowBox[{"W", "(", "z", ")"}], ")"}], ",", 
            RowBox[{"-", 
              RowBox[{"Im", "(", 
                RowBox[{"W", "(", "z", ")"}], ")"}]}]}], "}"}], 
        TraditionalForm]]],
  ". The ",
  "branch cut",
  " along the interval ",
  Cell[BoxData[
      FormBox[
        StyleBox[
          RowBox[{
            RowBox[{"(", 
              RowBox[{
                RowBox[{"-", "\[Infinity]"}], ",", 
                RowBox[{
                  RowBox[{"-", "1"}], "/", "\[ExponentialE]"}]}]}], "]"}],
          AutoStyleOptions->{"UnmatchedBracketStyle"->None}], 
        TraditionalForm]]],
  " and the ",
  "zero",
  " at ",
  Cell[BoxData[
      FormBox[
        RowBox[{"z", "=", "0"}], TraditionalForm]]],
  " are clearly visible."
}], "Text"],

Cell["\<\
ppx = 41; ppy = Round[ppx NUy/NUx];

tab = Module[{\[Delta]x = 2 NUxMax/ppx, \[Delta]y = 2 NUyMax/ppy,
              z0, w0, zz, wz, \[Lambda], normal},
Table[z0 = N[(-NUxMax NUx + i/ppx (2 NUxMax NUx)) + 
             (-NUyMax NUy + j/ppy (2 NUyMax NUy)) I];
      w0 = F[z0];
      zz = {Re[z0], Im[z0]};
      wz = {\[Delta]x ArcTan[Re[w0]]/(Pi/2), \[Delta]y \
ArcTan[Im[w0]]/(Pi/2)};
      \[Lambda] = 0.5 Sqrt[#.#&[wz]];
      normal = #/Sqrt[#.#]&[Reverse[wz]{-1, 1}]; 
      {Hue[(Pi + ArcTan @@ wz)/(2Pi)], 
       Line[{zz + \[Lambda] Sqrt[3]/2 normal, zz + wz, zz - \[Lambda] \
Sqrt[3]/2 normal}]},
      {i, 0, ppx}, {j, 0, ppy}]];
      
Off[Graphics::\"gptn\"];
Show[Graphics[{Thickness[0.002], tab}],
     AspectRatio -> Automatic, Frame -> True,
     FrameTicks -> {Table[k NUx, {k, -NUxMax, NUxMax}],
                    Table[k NUy, {k, -NUyMax, NUyMax}], None, None}];   \
\
\>", "Input"],

Cell[TextData[{
  "Modified ",
  "P\[OAcute]lya plot",
  " of ",
  Cell[BoxData[
      FormBox[
        RowBox[{"W", "(", "z", ")"}], TraditionalForm]]],
  ". The individual arrowheads have the ",
  "direction",
  " ",
  Cell[BoxData[
      FormBox[
        RowBox[{"{", 
          RowBox[{
            RowBox[{"Re", "(", 
              RowBox[{"W", "(", "z", ")"}], ")"}], ",", 
            RowBox[{"-", 
              RowBox[{"Im", "(", 
                RowBox[{"W", "(", "z", ")"}], ")"}]}]}], "}"}], 
        TraditionalForm]]],
  ", their coloring is according to the ",
  "argument",
  ", and their size according to the ",
  "absolute value",
  " of ",
  Cell[BoxData[
      FormBox[
        RowBox[{"W", "(", "z", ")"}], TraditionalForm]]],
  "."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["Conformal map graphics", "Section"],

Cell[CellGroupData[{

Cell["Images of concentric circles around the origin", "Subsection"],

Cell["\<\
rMax = Pi; \[CurlyEpsilon] = 10^-12;
\[CurlyPhi]Ranges = (# + {+\[CurlyEpsilon], - \[CurlyEpsilon]})& /@ \
Partition[Table[k Pi/4, {k, -4, 4, 1}], 2, 1];

EAPS[
{beforeCPlot, afterCPlot} = 
 Function[f, Show[Table[
 ParametricPlot[{Re[f[r Exp[I \[CurlyPhi]]]], Im[f[r Exp[I \[CurlyPhi]]]]}, {\
\[CurlyPhi], ##}, 
         PlotPoints -> 100, PlotRange -> Pi {{-1, 1}, {-1, 1}},
         PlotStyle -> {Thickness[0.0001], Hue[0.8 r/rMax]},
         Frame -> True, Axes -> False, FrameTicks -> False,
         AspectRatio -> Automatic,  DisplayFunction -> Identity]& @@@ \
\[CurlyPhi]Ranges, 
         {r, 0, rMax, rMax/36}], DisplayFunction -> $DisplayFunction]] /@ \
{Id, F}];\
\>", "Input"],

Cell["\<\
Show[GraphicsArray[{beforeCPlot, arrowGraphics, afterCPlot}],
                   GraphicsSpacing -> -0.4];\
\>", "Input"],

Cell[TextData[{
  "Images",
  " of ",
  "concentric circles",
  " of radii between ",
  Cell[BoxData[
      FormBox["0", TraditionalForm]]],
  " and ",
  Cell[BoxData[
      FormBox["\[Pi]", TraditionalForm]]],
  " around the ",
  "origin",
  " under the (",
  "conformal",
  ") ",
  "map",
  " ",
  Cell[BoxData[
      FormBox[
        RowBox[{"z", "\[RightTeeArrow]", 
          RowBox[{"W", "(", "z", ")"}]}], TraditionalForm]]],
  ". Large ",
  "circles",
  " are mapped into parallel lines with increasing ",
  "real parts",
  "."
}], "Text"],

Cell["\<\
rMax =  3/2 Pi;

EAPS[
{beforeCPlot, afterCPlot} = 
Function[f, tab = Table[
 ParametricPlot[{Re[f[r Exp[I \[CurlyPhi]]]], Im[f[r Exp[I \[CurlyPhi]]]]}, {\
\[CurlyPhi], ##}, 
         PlotPoints -> 100, PlotRange -> All,
         PlotStyle -> {Thickness[0.0001], Hue[0.8 r/rMax]},
         Frame -> True, Axes -> False, FrameTicks -> False,
         AspectRatio -> Automatic, DisplayFunction -> Identity][[1]]& @@@ \
\[CurlyPhi]Ranges, 
         {r, 0, rMax, rMax/24}];
  Show[Graphics3D[tab /. Line[l_] :> Line[toRiemannSphere /@ l]],
       PlotRange -> All, Boxed -> False]] /@ {Id, F}];         \
\>", "Input"],

Cell["\<\
Show[GraphicsArray[{beforeCPlot, arrowGraphics, afterCPlot}],
                    GraphicsSpacing -> -0.4];\
\>", "Input"],

Cell[TextData[{
  "Images",
  " of the ",
  "Riemann sphere",
  " of ",
  "concentric circles",
  " of radii between ",
  Cell[BoxData[
      FormBox["0", TraditionalForm]]],
  " and ",
  Cell[BoxData[
      FormBox[
        RowBox[{
          RowBox[{"3", "/", "2"}], "\[Pi]"}], TraditionalForm]]],
  " around the ",
  "origin",
  " under the (",
  "conformal",
  ") ",
  "map",
  " ",
  Cell[BoxData[
      FormBox[
        RowBox[{"z", "\[RightTeeArrow]", 
          RowBox[{"W", "(", "z", ")"}]}], TraditionalForm]]],
  ". Circles are split into two parts because of the ",
  "branch cuts",
  " along the ",
  "imaginary axis",
  "."
}], "Text"],

Cell["\<\
\[CurlyEpsilon] = 10^-5;

EAPS[
{beforeCPlot, afterCPlot} = 
Function[f, Show[(removeLineJumps[#, 1]& @
   ParametricPlot[Evaluate@Table[{Abs[f[r Exp[I \[CurlyPhi]]]], 
                                  Arg[f[r Exp[I \[CurlyPhi]]]]}, {r, 0, 3, \
1/10}],
                 {\[CurlyPhi], ##}, PlotPoints -> 100,   
                PlotRange -> All, FrameLabel -> {\"R\",\"\[Phi]\"},
         PlotStyle -> Table[{Thickness[0.0001], 
                             Hue[0.8 r/3]}, {r, \[CurlyEpsilon], 3 + \
\[CurlyEpsilon], 1/10}],
         Frame -> True, Axes -> False, AspectRatio -> 1,
         FrameTicks -> {Automatic, {-Pi, 0, Pi}, None, None}]& @@@ \
\[CurlyPhi]Ranges)]] /@ {Id, F}];\
\>", "Input"],

