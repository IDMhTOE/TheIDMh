Identity],
               AxesLabel -> {\"f\", \"f'\"}, Axes -> False, Frame -> True]& \
/@ 
{{Re, {Hue[0.1], Hue[0.94]}, {{-1, 1}, {-2, 3}}}, 
 {Im, {Hue[0.7], Hue[0.85]}, Automatic}}]];\
