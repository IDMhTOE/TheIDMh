  {SurfaceColor[blue, blue, 2.1], EdgeForm[{}],
   makeDiamond /@ Cases[Graphics3D[imPLower], _Polygon, \[Infinity]]}}],
   BoxRatios -> {5, 1, 1}, ViewPoint -> {1, 3, 1}, PlotRange -> {-3, 3},
   Axes -> True, Ticks -> {Table[i NUx, {i, -7, 7}], {0, -1, -2}, \
Automatic}]];\
\>", "Input"],

Cell["\<\
tubeRadiusRe = 0.06; \[CurlyEpsilon] = 10^-3;
longitudinalCurvePoints = 32 ;
transversalCurvePoints = 12;
curveSpineRe = Table[{x, tubeRadiusRe, Re[F[x]]}, 
                     {x, -3 + \[CurlyEpsilon], -0 - \[CurlyEpsilon], (3 - 2\
\[CurlyEpsilon])/longitudinalCurvePoints}] // N;
EAPS[
fReTube1 = Show[Graphics3D[makeTube[addEnds[Line @ Take[curveSpineRe, All]], 
         makeStartCrossSection[curveSpineRe, tubeRadiusRe, \
transversalCurvePoints]]]]];\
\>", "Input"],

Cell["\<\
tubeRadiusRe = 0.06;
longitudinalCurvePoints = 32 ;
transversalCurvePoints = 12;
curveSpineRe = Table[{x, tubeRadiusRe, Re[F[x]]}, 
                     {x, 0 + \[CurlyEpsilon], 3 - \[CurlyEpsilon], (3 - 2\
\[CurlyEpsilon])/longitudinalCurvePoints}] // N;
EAPS[
fReTube2 = Show[Graphics3D[makeTube[addEnds[Line @ Take[curveSpineRe, All]], 
         makeStartCrossSection[curveSpineRe, tubeRadiusRe, \
transversalCurvePoints]]]]];\
\>", "Input"],

Cell["\<\
tubeRadiusIm = 3/4 tubeRadiusRe ;
