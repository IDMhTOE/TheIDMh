Cell[CellGroupData[{

Cell["Images of a square grid", "Subsection"],

Cell["\<\
contractLines[expr_, \[Alpha]_] :=  expr /. Line[{p1_, p2_}] :>
With[{mp = (p1 + p2)/2},  Line[{mp + \[Alpha] (p1 - mp), mp + \[Alpha] (p2 - \
mp)}]]\
\>", "Input"],

Cell["\<\
XY = 2; n = 36; pp = 240;
horizontalGridLines = contractLines[#, 1 - 10^-3]& @
 Table[Line /@ Partition[Table[N[{x, y}], {x, -XY, XY, 2XY/pp}], 2, 1],
            {y, -XY, XY, 2XY/n}];
verticalGridLines = contractLines[#, 1 - 10^-3]& @
 Table[Line /@ Partition[Table[N[{x, y}], {y, -XY, XY, 2XY/pp}], 2, 1],
            {x, -XY, XY, 2XY/n}];\
\>", "Input"],

Cell["\<\
{beforeCPlot, afterCPlot} = 
Function[f, Graphics[{Thickness[0.001],
{{RGBColor[1, 0, 0], Map[{Re[#], Im[#]}&[ f[#[[1]] + I #[[2]]]]&, 
                         horizontalGridLines, {-2}]},
 {RGBColor[0, 0, 1], Map[{Re[#], Im[#]}&[ f[#[[1]] + I #[[2]]]]&, 
                          verticalGridLines, {-2}]}}},
     AspectRatio -> Automatic]] /@ {Id, F};\
\>", "Input"],

Cell["\<\
Show[GraphicsArray[{beforeCPlot, arrowGraphics, afterCPlot}],
                   GraphicsSpacing -> -0.3];\
\>", "Input"],

