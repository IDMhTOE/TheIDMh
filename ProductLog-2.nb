          RowBox[{"[", 
            RowBox[{
              RowBox[{"-", "2"}], ",", "2"}], "]"}], "\[Times]", 
          RowBox[{"[", 
            RowBox[{
              RowBox[{"-", "2"}], ",", "2"}], "]"}]}], TraditionalForm]]],
  " under the (",
  "conformal",
  ") ",
  "map",
  " ",
  Cell[BoxData[
      FormBox[
        RowBox[{"z", "\[RightTeeArrow]", 
          RowBox[{"W", "(", "z", ")"}]}], TraditionalForm]]],
  ". "
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["Images of the tessellated Riemann sphere", "Subsection"],

Cell["\<\
colorTriangle[Polygon[l_]] := 
{Hue[((ArcTan  @@ Take[Plus @@ l/Length[l], 2]) + Pi)/(2Pi)], \
Polygon[l]};\
\>", "Input"],

Cell["\<\
coloredTriangles = colorTriangle /@ icosahedronTriangles[12, \
0.9];\
\>", "Input"],

Cell["\<\
beforeCPlot = Graphics3D[{EdgeForm[], 
       coloredTriangles}, Axes -> False, Lighting -> False,  Boxed -> False,
                          PlotRange -> All];\
\>", "Input"],

Cell["\<\
afterCPlot = removeBigPolygons[beforeCPlot /. Polygon[l_] :>
Polygon[toRiemannSphere[F @ fromRiemannSphere[#]]& /@ l], 0.2];\
\>", "Input"],

Cell["\<\
Show[GraphicsArray[{beforeCPlot, arrowGraphics, afterCPlot}],
                   GraphicsSpacing -> -0.4];\
\>", "Input"],

Cell[TextData[{
  "Images",
  " of ",
  "triangles",
  " on the ",
  "Riemann sphere",
  " under the (",
  "conformal",
  ") ",
  "map",
  " ",
  Cell[BoxData[
      FormBox[
        RowBox[{"z", "\[RightTeeArrow]", 
          RowBox[{"W", "(", "z", ")"}]}], TraditionalForm]]],
  ". "
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["Plane to plane map", "Subsection"],

Cell["\<\
\[CurlyEpsilon] = 10.^-6; R = Pi; pp = 24; \[ScriptCapitalR]=.;
\[ScriptCapitalR][\[CurlyPhi]_] := \[ScriptCapitalR][\[CurlyPhi]] = {{Cos[\
\[CurlyPhi]], 0, Sin[\[CurlyPhi]]}, {0, 1, 0}, {-Sin[\[CurlyPhi]], 0, Cos[\
\[CurlyPhi]]}} // N;

Show[Graphics3D[{Thickness[0.001],
Table[{Hue[(ArcTan[x, y] + Pi)/Pi/2],
      Line[Table[\[ScriptCapitalR][Pi/2 \[Alpha]].{Re[#], Im[#], 0}&[(x + I \
y)^(1 - \[Alpha]) F[x + I y]^\[Alpha]], 
      {\[Alpha], 0, 1, 1/20}]]},
      {x, -R + \[CurlyEpsilon], R, (2R - \[CurlyEpsilon])/pp}, {y, -R + \
\[CurlyEpsilon], R, (2R - \[CurlyEpsilon])/pp}]}], 
      BoxRatios -> {1, 1, 1}, ViewPoint -> {-1, -4, 2}, 
      PlotRange -> {All, All, {2, -2}}, Axes -> True];\
\>", "Input"],

Cell[TextData[{
  "Curves",
  " ",
  Cell[BoxData[
      FormBox[
        RowBox[{"{", 
          RowBox[{
            RowBox[{
              RowBox[{"cos", "(", 
                FractionBox[
                  RowBox[{"\[Pi]", " ", "\[Alpha]"}], "2"], ")"}], " ", 
              RowBox[{"Re", "(", 
                RowBox[{
                  SuperscriptBox["z", 
                    RowBox[{"1", "-", "\[Alpha]"}]], " ", 
                  SuperscriptBox[
                    RowBox[{"W", "(", "z", ")"}], "\[Alpha]"]}], ")"}]}], ",",
             
            RowBox[{"Im", "(", 
              RowBox[{
                SuperscriptBox["z", 
                  RowBox[{"1", "-", "\[Alpha]"}]], " ", 
                SuperscriptBox[
                  RowBox[{"W", "(", "z", ")"}], "\[Alpha]"]}], ")"}], ",", 
            RowBox[{
              RowBox[{"-", 
                RowBox[{"sin", "(", 
                  FractionBox[
                    RowBox[{"\[Pi]", " ", "\[Alpha]"}], "2"], ")"}]}], 
              RowBox[{"Re", "(", 
                RowBox[{
                  SuperscriptBox["z", 
                    RowBox[{"1", "-", "\[Alpha]"}]], " ", 
                  SuperscriptBox[
                    RowBox[{"W", "(", "z", ")"}], "\[Alpha]"]}], ")"}]}], 
            " "}], "}"}], TraditionalForm]]],
  " parametrized by ",
  Cell[BoxData[
      FormBox["\[Alpha]", TraditionalForm]]],
  ". Points ",
  Cell[BoxData[
      FormBox[
        RowBox[{"{", 
          RowBox[{"x", ",", "y", ",", "0"}], "}"}], TraditionalForm]]],
  " (where ",
  Cell[BoxData[
      FormBox[
        RowBox[{"z", "=", 
          RowBox[{"x", "+", 
            RowBox[{"\[ImaginaryI]", " ", "y"}]}]}], TraditionalForm]]],
  ") move smoothly into points ",
  Cell[BoxData[
      FormBox[
        RowBox[{"{", 
          RowBox[{"0", ",", 
            RowBox[{"Re", "(", 
              RowBox[{"W", "(", "w", ")"}], ")"}], ",", 
            RowBox[{"Im", "(", 
              RowBox[{"W", "(", "w", ")"}], ")"}]}], "}"}], 
        TraditionalForm]]],
  "."
}], "Text"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["3D plots over the complex plane", "Section"],

Cell[CellGroupData[{

Cell["Entering the complex plane", "Subsection"],

Cell["\<\
\[CurlyEpsilon] = 10^-3;
EAPS[
{rePUpper, imPUpper} = Plot3D[#[F[x + I y]], 
            {x, -NUxMax NUx, NUxMax NUx,  NUxMax NUx}, {y, \[CurlyEpsilon], \
2},
       PlotPoints -> {120, 12}, BoxRatios -> {5, 1, 1},
       ViewPoint -> {1, -3, 1}]& /@ {Re, Im}];\
\>", "Input"],

Cell["\<\
EAPS[
Show[Graphics3D[
 {{SurfaceColor[red, red, 2.1], EdgeForm[{Thickness[0.0001]}],
   Cases[Graphics3D[rePUpper], _Polygon, \[Infinity]]}, 
  {SurfaceColor[blue, blue, 2.1], EdgeForm[{}],
   makeDiamond /@ Cases[Graphics3D[imPUpper], _Polygon, \[Infinity]]}}],
   BoxRatios -> {5, 1, 1}, ViewPoint -> {1, -3, 1}, PlotRange -> {-3, 3},
   Axes -> True, Ticks -> {Table[i NUx, {i, -7, 7}], {0, 1, 2}, Automatic}]];\
\
\>", "Input"],

Cell["\<\
\[CurlyEpsilon] = 10^-12;
EAPS[
{rePLower, imPLower} = Plot3D[#[F[x + I y]], 
{x, -NUxMax NUx, NUxMax NUx, NUxMax NUx}, {y, -\[CurlyEpsilon], -2},
       PlotPoints -> {120, 12}, BoxRatios -> {5, 1, 1},
       ViewPoint -> {1, 3, 1}]& /@ {Re, Im}];\
\>", "Input"],

Cell["\<\
EAPS[
Show[Graphics3D[
 {{SurfaceColor[red, red, 2.1], EdgeForm[{Thickness[0.0001]}],
